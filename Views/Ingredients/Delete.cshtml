@{
}
@model Restaurant_Management__System.Models.Ingredient

@{
    ViewData["Title"] = "Delete Ingredient";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card">

            <div class="card-body p-4">

                <div class="text-center mb-4">

                    <i class="bi bi-exclamation-triangle text-danger"
                       style="font-size:65px;">
                    </i>

                    <h3 class="fw-bold mt-3">
                        Delete Ingredient?
                    </h3>

                    <p class="text-muted">
                        Are you sure you want to delete this ingredient?
                    </p>

                </div>

                <div class="alert alert-danger">

                    <div class="row mb-2">

                        <div class="col-5 fw-bold">
                            Ingredient ID:
                        </div>

                        <div class="col-7">
                            @Model.IngredientId
                        </div>

                    </div>

                    <div class="row mb-2">

                        <div class="col-5 fw-bold">
                            Ingredient Name:
                        </div>

                        <div class="col-7">
                            @Model.IngredientName
                        </div>

                    </div>

                    <div class="row mb-2">

                        <div class="col-5 fw-bold">
                            Supplier:
                        </div>

                        <div class="col-7">
                            @if (Model.Supplier != null)
                            {
                                @Model.Supplier.SupplierName
                            }
                            else
                            {
                                <span>No Supplier</span>
                            }
                        </div>

                    </div>

                    <div class="row mb-2">

                        <div class="col-5 fw-bold">
                            Stock:
                        </div>

                        <div class="col-7">
                            @Model.Stock @Model.Unit
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-5 fw-bold">
                            Unit:
                        </div>

                        <div class="col-7">
                            @Model.Unit
                        </div>

                    </div>

                </div>

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="IngredientId" />

                    <div class="d-flex justify-content-center gap-2">

                        <button type="submit"
                                class="btn btn-danger">

                            <i class="bi bi-trash"></i>
                            Yes, Delete

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            <i class="bi bi-x-circle"></i>
                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>