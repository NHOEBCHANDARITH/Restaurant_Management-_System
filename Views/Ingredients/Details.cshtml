@{
}
@model Restaurant_Management__System.Models.Ingredient

@{
    ViewData["Title"] = "Ingredient Details";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>
                        <h3 class="fw-bold mb-1">
                            Ingredient Details
                        </h3>

                        <p class="text-muted mb-0">
                            View ingredient information
                        </p>
                    </div>

                    <i class="bi bi-box-seam text-primary"
                       style="font-size:45px;">
                    </i>

                </div>

                <div class="table-responsive">

                    <table class="table table-bordered">

                        <tr>
                            <th style="width:35%;">
                                Ingredient ID
                            </th>

                            <td>
                                @Model.IngredientId
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Ingredient Name
                            </th>

                            <td>
                                <strong>
                                    @Model.IngredientName
                                </strong>
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Supplier
                            </th>

                            <td>
                                @if (Model.Supplier != null)
                                {
                                    @Model.Supplier.SupplierName
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No Supplier
                                    </span>
                                }
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Stock
                            </th>

                            <td>
                                @if (Model.Stock <= 0)
                                {
                                    <span class="badge bg-danger">
                                        Out of Stock
                                    </span>
                                }
                                else if (Model.Stock <= 10)
                                {
                                    <span class="badge bg-warning text-dark">
                                        @Model.Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        @Model.Stock
                                    </span>
                                }
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Unit
                            </th>

                            <td>
                                <span class="badge bg-secondary">
                                    @Model.Unit
                                </span>
                            </td>
                        </tr>

                    </table>

                </div>

                <hr />

                <div class="d-flex gap-2">

                    <a asp-action="Edit"
                       asp-route-id="@Model.IngredientId"
                       class="btn btn-warning">

                        <i class="bi bi-pencil"></i>
                        Edit

                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.IngredientId"
                       class="btn btn-danger">

                        <i class="bi bi-trash"></i>
                        Delete

                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Back

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>