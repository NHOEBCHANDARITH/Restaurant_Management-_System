@model Restaurant_Management__System.Models.Ingredient
@{
    ViewData["Title"] = "Ingredient Details - " + Model.IngredientName;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="rms-card">
            <div class="rms-card-header bg-light">
                <h5 class="rms-card-title">
                    <i class="bi bi-egg-fried text-warning"></i>
                    Kitchen Raw Stock Details
                </h5>
                <span class="badge bg-secondary font-monospace">#ING-@Model.IngredientId</span>
            </div>
            <div class="rms-card-body p-4 text-center">
                <div class="rms-brand-logo-icon mx-auto my-3" style="width: 72px; height: 72px; font-size: 32px;">
                    <i class="bi bi-boxes"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">@Model.IngredientName</h3>
                <p class="text-muted mb-4">Kitchen Procurement Inventory</p>

                <div class="border rounded-3 p-3 bg-light text-start mb-4 small">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-truck me-2"></i> Vendor Supplier</span>
                        <strong class="text-dark">@(Model.Supplier?.SupplierName ?? $"Supplier #{Model.SupplierId}")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-stack me-2"></i> Current Stock Level</span>
                        <strong class="text-dark font-monospace fs-6">@Model.Stock @Model.Unit</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted"><i class="bi bi-activity me-2"></i> Health Status</span>
                        <span>
                            @if (Model.Stock <= 0)
                            {
                                <span class="rms-badge rms-badge-danger"><span class="rms-badge-dot"></span> Out of Stock</span>
                            }
                            else if (Model.Stock < 10)
                            {
                                <span class="rms-badge rms-badge-warning"><span class="rms-badge-dot"></span> Low Stock</span>
                            }
                            else
                            {
                                <span class="rms-badge rms-badge-success"><span class="rms-badge-dot"></span> Adequate Stock</span>
                            }
                        </span>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.IngredientId" class="btn rms-btn-primary">
                        <i class="bi bi-pencil"></i> Edit Ingredient
                    </a>
                    <a asp-controller="Inventories" asp-action="Index" class="btn rms-btn-outline">
                        <i class="bi bi-boxes"></i> Track in Inventory
                    </a>
                    <a asp-action="Index" class="btn rms-btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>