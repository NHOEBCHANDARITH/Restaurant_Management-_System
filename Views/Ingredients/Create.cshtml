@model Restaurant_Management__System.Models.Ingredient
@{
    ViewData["Title"] = "Add Ingredient";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="rms-form-card">
            <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                <div class="rms-brand-logo-icon" style="width: 44px; height: 44px; font-size: 20px;">
                    <i class="bi bi-egg-fried"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-dark mb-0">Register Kitchen Ingredient</h4>
                    <small class="text-muted">Add raw food materials, spices, or cooking supplies</small>
                </div>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="rms-alert rms-alert-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="IngredientName" class="rms-form-label">
                            Ingredient Name <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-tag rms-input-icon"></i>
                            <input asp-for="IngredientName" class="rms-form-control" placeholder="e.g. Kampot Black Pepper" required autofocus />
                        </div>
                        <span asp-validation-for="IngredientName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SupplierId" class="rms-form-label">
                            Vendor Supplier <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-truck rms-input-icon"></i>
                            <select asp-for="SupplierId" class="form-select rms-form-control" asp-items="ViewBag.SupplierId" required>
                                <option value="">-- Select Supplier --</option>
                            </select>
                        </div>
                        <span asp-validation-for="SupplierId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Stock" class="rms-form-label">
                            Initial Quantity in Stock <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-boxes rms-input-icon"></i>
                            <input asp-for="Stock" type="number" min="0" class="rms-form-control" placeholder="e.g. 50" required />
                        </div>
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Unit" class="rms-form-label">
                            Measurement Unit <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-rulers rms-input-icon"></i>
                            <select asp-for="Unit" class="form-select rms-form-control" required>
                                <option value="kg" selected>Kilograms (kg)</option>
                                <option value="g">Grams (g)</option>
                                <option value="L">Liters (L)</option>
                                <option value="ml">Milliliters (ml)</option>
                                <option value="pcs">Pieces (pcs)</option>
                                <option value="pack">Packs</option>
                                <option value="box">Boxes</option>
                            </select>
                        </div>
                        <span asp-validation-for="Unit" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn rms-btn-primary">
                        <i class="bi bi-save"></i> Save Ingredient
                    </button>
                    <a asp-action="Index" class="btn rms-btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}