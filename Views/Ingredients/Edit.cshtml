    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model Restaurant_Management__System.Models.Ingredient

@{
    ViewData["Title"] = "Edit Ingredient";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card">

            <div class="card-body p-4">

                <h3 class="fw-bold mb-4">
                    <i class="bi bi-pencil text-warning"></i>
                    Edit Ingredient
                </h3>

                <form asp-action="Edit" method="post">

                    <input type="hidden"
                           asp-for="IngredientId" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="row">

                        <!-- Ingredient Name -->
                        <div class="col-md-6 mb-3">

                            <label asp-for="IngredientName"
                                   class="form-label fw-semibold">
                                Ingredient Name
                            </label>

                            <input asp-for="IngredientName"
                                   class="form-control" />

                            <span asp-validation-for="IngredientName"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Supplier -->
                        <div class="col-md-6 mb-3">

                            <label asp-for="SupplierId"
                                   class="form-label fw-semibold">
                                Supplier
                            </label>

                            <select asp-for="SupplierId"
                                    class="form-select"
                                    asp-items="ViewBag.SupplierId">

                                <option value="">
                                    -- Select Supplier --
                                </option>

                            </select>

                            <span asp-validation-for="SupplierId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Stock -->
                        <div class="col-md-6 mb-3">

                            <label asp-for="Stock"
                                   class="form-label fw-semibold">
                                Stock
                            </label>

                            <input asp-for="Stock"
                                   type="number"
                                   min="0"
                                   class="form-control" />

                            <span asp-validation-for="Stock"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Unit -->
                        <div class="col-md-6 mb-3">

                            <label asp-for="Unit"
                                   class="form-label fw-semibold">
                                Unit
                            </label>

                            <select asp-for="Unit"
                                    class="form-select">

                                <option value="kg">
                                    Kilogram (kg)
                                </option>

                                <option value="g">
                                    Gram (g)
                                </option>

                                <option value="liter">
                                    Liter (L)
                                </option>

                                <option value="ml">
                                    Milliliter (ml)
                                </option>

                                <option value="piece">
                                    Piece
                                </option>

                                <option value="pack">
                                    Pack
                                </option>

                            </select>

                            <span asp-validation-for="Unit"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <hr />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-warning">

                            <i class="bi bi-check-circle"></i>
                            Update

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            <i class="bi bi-arrow-left"></i>
                            Back

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}