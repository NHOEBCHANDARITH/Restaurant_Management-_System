<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Restaurant Management System</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <!-- ================= MODERN NAVBAR ================= -->
    <nav class="public-navbar">
        <div class="public-navbar-container">

            <!-- LOGO BRAND -->
            <a class="public-brand" asp-controller="Home" asp-action="Index">
                <div class="public-brand-icon">
                    <i class="bi bi-shop"></i>
                </div>
                <div class="public-brand-text">
                    <strong>Resto</strong>
                    <span>Restaurant</span>
                </div>
            </a>

            <!-- MOBILE BUTTON -->
            <button class="public-mobile-btn" type="button" data-bs-toggle="collapse" data-bs-target="#publicNavbar" aria-controls="publicNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list"></i>
            </button>

            <!-- NAVIGATION LINKS -->
            <div class="collapse navbar-collapse" id="publicNavbar">
                <ul class="public-nav-menu">

                    <!-- HOME -->
                    <li>
                        <a asp-controller="Home" asp-action="Index" class="public-nav-link">
                            <i class="bi bi-house"></i>
                            <span>Home</span>
                        </a>
                    </li>

                    <!-- MENU -->
                    <li>
                        <a asp-controller="MenuItems" asp-action="Index" class="public-nav-link">
                            <i class="bi bi-cup-hot"></i>
                            <span>Menu</span>
                        </a>
                    </li>

                    <!-- RESERVATIONS -->
                    <li>
                        <a asp-controller="Reservations" asp-action="Index" class="public-nav-link">
                            <i class="bi bi-calendar-check"></i>
                            <span>Reservations</span>
                        </a>
                    </li>

                    <!-- MANAGEMENT DROPDOWN -->
                    <li class="nav-item dropdown">
                        <a class="public-nav-link dropdown-toggle" href="#" id="manageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-grid-3x3-gap"></i>
                            <span>Management</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-modern shadow-lg" aria-labelledby="manageDropdown">
                            <li class="dropdown-header"><i class="bi bi-cup-hot me-1"></i> Food & Menu</li>
                            <li><a class="dropdown-item" asp-controller="MenuItems" asp-action="Index"><i class="bi bi-card-list"></i>Menu Items</a></li>
                            <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i>Categories</a></li>
                            
                            <li><hr class="dropdown-divider"></li>
                            <li class="dropdown-header"><i class="bi bi-cart-check me-1"></i> Orders & Billing</li>
                            <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt"></i>Orders</a></li>
                            <li><a class="dropdown-item" asp-controller="OrderDetails" asp-action="Index"><i class="bi bi-list-check"></i>Order Details</a></li>
                            <li><a class="dropdown-item" asp-controller="Payments" asp-action="Index"><i class="bi bi-credit-card"></i>Payments</a></li>

                            <li><hr class="dropdown-divider"></li>
                            <li class="dropdown-header"><i class="bi bi-people me-1"></i> Tables & Guests</li>
                            <li><a class="dropdown-item" asp-controller="Reservations" asp-action="Index"><i class="bi bi-calendar2-week"></i>Reservations</a></li>
                            <li><a class="dropdown-item" asp-controller="DiningTables" asp-action="Index"><i class="bi bi-table"></i>Dining Tables</a></li>
                            <li><a class="dropdown-item" asp-controller="Customers" asp-action="Index"><i class="bi bi-person-lines-fill"></i>Customers</a></li>

                            <li><hr class="dropdown-divider"></li>
                            <li class="dropdown-header"><i class="bi bi-box-seam me-1"></i> Stock & System</li>
                            <li><a class="dropdown-item" asp-controller="Inventories" asp-action="Index"><i class="bi bi-boxes"></i>Inventories</a></li>
                            <li><a class="dropdown-item" asp-controller="Ingredients" asp-action="Index"><i class="bi bi-egg-fried"></i>Ingredients</a></li>
                            <li><a class="dropdown-item" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck"></i>Suppliers</a></li>
                            <li><a class="dropdown-item" asp-controller="Users" asp-action="Index"><i class="bi bi-person-badge"></i>Staff Users</a></li>
                        </ul>
                    </li>

                    <!-- ABOUT -->
                    <li>
                        <a href="/#about" class="public-nav-link">
                            <i class="bi bi-info-circle"></i>
                            <span>About Us</span>
                        </a>
                    </li>

                    <!-- CONTACT -->
                    <li>
                        <a href="/#contact" class="public-nav-link">
                            <i class="bi bi-telephone"></i>
                            <span>Contact</span>
                        </a>
                    </li>

                </ul>

                <!-- NAVBAR RIGHT -->
                <div class="public-navbar-right">

                    <!-- ORDERS / TRACKING -->
                    <a asp-controller="Orders" asp-action="Index" class="public-icon-btn position-relative" title="Orders">
                        <i class="bi bi-bag"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary" style="font-size: 10px;">
                            <i class="bi bi-dot"></i>
                        </span>
                    </a>

                    <!-- STAFF USERS -->
                    <a asp-controller="Users" asp-action="Index" class="public-login-btn">
                        <i class="bi bi-person-circle"></i>
                        Staff
                    </a>

                    <!-- BOOK A TABLE -->
                    <a asp-controller="Reservations" asp-action="Create" class="public-book-btn">
                        <i class="bi bi-calendar-plus"></i>
                        Book a Table
                    </a>

                </div>

            </div>

        </div>
    </nav>

    <!-- ================= MAIN CONTENT ================= -->
    @if (ViewData["FullWidth"] != null && (bool)ViewData["FullWidth"])
    {
        <main class="public-main-content">
            @RenderBody()
        </main>
    }
    else
    {
        <main class="public-main-content py-4">
            <div class="container py-2">
                @RenderBody()
            </div>
        </main>
    }

    <!-- ================= FOOTER ================= -->
    <footer class="public-footer">
        <div class="container">
            <div class="row g-4">

                <!-- 1. BRAND & ABOUT -->
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand mb-3">
                        <div class="footer-brand-icon">
                            <i class="bi bi-shop"></i>
                        </div>
                        <div class="footer-brand-text">
                            <strong>Resto</strong>
                            <span>Restaurant</span>
                        </div>
                    </div>
                    <p class="footer-desc">
                        Exquisite dining experience and outstanding service. We are ready to serve you delicious dishes, seamless table bookings, and smooth dining management.
                    </p>
                    <!-- SOCIAL LINKS -->
                    <div class="footer-socials">
                        <a href="#" class="social-link" title="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-link" title="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-link" title="Telegram"><i class="bi bi-telegram"></i></a>
                        <a href="#" class="social-link" title="TikTok"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>

                <!-- 2. QUICK LINKS -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="footer-title">Quick Links</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right"></i> Home</a></li>
                        <li><a asp-controller="MenuItems" asp-action="Index"><i class="bi bi-chevron-right"></i> Our Menu</a></li>
                        <li><a asp-controller="Reservations" asp-action="Create"><i class="bi bi-chevron-right"></i> Book a Table</a></li>
                        <li><a asp-controller="Orders" asp-action="Index"><i class="bi bi-chevron-right"></i> Track Orders</a></li>
                        <li><a href="/#about"><i class="bi bi-chevron-right"></i> About Us</a></li>
                    </ul>
                </div>

                <!-- 3. MANAGEMENT & SYSTEM -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-title">Management</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Orders" asp-action="Index"><i class="bi bi-chevron-right"></i> Orders Management</a></li>
                        <li><a asp-controller="Payments" asp-action="Index"><i class="bi bi-chevron-right"></i> Payments & Bills</a></li>
                        <li><a asp-controller="DiningTables" asp-action="Index"><i class="bi bi-chevron-right"></i> Dining Tables</a></li>
                        <li><a asp-controller="Categories" asp-action="Index"><i class="bi bi-chevron-right"></i> Food Categories</a></li>
                        <li><a asp-controller="Users" asp-action="Index"><i class="bi bi-chevron-right"></i> Staff Users</a></li>
                    </ul>
                </div>

                <!-- 4. CONTACT & WORKING HOURS -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-title">Contact Us</h6>
                    <ul class="footer-contact">
                        <li>
                            <i class="bi bi-geo-alt"></i>
                            <span>Phnom Penh, Cambodia</span>
                        </li>
                        <li>
                            <i class="bi bi-telephone"></i>
                            <span>+855 12 345 678</span>
                        </li>
                        <li>
                            <i class="bi bi-envelope"></i>
                            <span>info@restorst.com</span>
                        </li>
                        <li>
                            <i class="bi bi-clock"></i>
                            <span>Mon - Sun: 08:00 AM - 10:00 PM</span>
                        </li>
                    </ul>
                </div>

            </div>

            <!-- FOOTER BOTTOM -->
            <div class="footer-bottom">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                        &copy; 2026 <strong>Resto Restaurant Management System</strong>. All rights reserved.
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <span class="footer-badge"><i class="bi bi-shield-check"></i> Powered by #48beda Modern UI</span>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- ================= SCRIPTS ================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
