@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center py-5">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 text-center p-4 p-md-5">
            <div class="mb-4">
                <i class="bi bi-exclamation-triangle text-danger" style="font-size: 64px;"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Something went wrong</h2>
            <p class="text-muted mb-4">An error occurred while processing your request.</p>

            @if (Model.ShowRequestId)
            {
                <div class="alert alert-light border mb-4 text-start font-monospace small">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </div>
            }

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house me-1"></i> Return Home
                </a>
            </div>
        </div>
    </div>
</div>
