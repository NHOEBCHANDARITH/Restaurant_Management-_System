@model Restaurant_Management__System.Models.DiningTable
@{
    ViewData["Title"] = "Delete Table " + Model.TableNumber;
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="rms-card">
            <div class="rms-card-body p-4 text-center">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" 
                     style="width: 72px; height: 72px; background: rgba(239, 68, 68, 0.12); color: #ef4444; font-size: 32px;">
                    <i class="bi bi-trash3-fill"></i>
                </div>

                <h4 class="fw-bold text-dark mb-1">Delete Dining Table?</h4>
                <p class="text-muted small mb-4">
                    Are you sure you want to permanently remove <strong class="text-dark">Table @Model.TableNumber</strong>? 
                    Active orders or reservations linked to this table may be affected.
                </p>

                <div class="border rounded-3 p-3 bg-light text-start mb-4 small">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Table Number</span>
                        <strong class="text-dark">@Model.TableNumber</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Capacity</span>
                        <strong class="text-dark">@Model.Capacity Guests</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Current Status</span>
                        <strong class="text-dark">@Model.Status</strong>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="TableId" />
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Index" class="btn rms-btn-secondary">Cancel</a>
                        <button type="submit" class="btn rms-btn-danger">
                            <i class="bi bi-trash"></i> Yes, Delete Table
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>