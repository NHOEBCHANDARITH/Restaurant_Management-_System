@{
}
@model Restaurant_Management__System.Models.DiningTable

@{
    ViewData["Title"] = "Delete Dining Table";
}

<div class="row justify-content-center">

    <div class="col-md-7">

        <div class="card">

            <div class="card-body p-4 text-center">

                <i class="bi bi-exclamation-triangle-fill text-danger"
                   style="font-size: 70px;">
                </i>

                <h3 class="fw-bold mt-3">
                    Delete Dining Table?
                </h3>

                <p class="text-muted">
                    Are you sure you want to delete this dining table?
                    This action cannot be undone.
                </p>

                <div class="alert alert-light text-start">

                    <div class="row mb-2">

                        <div class="col-5 fw-bold">
                            Table ID:
                        </div>

                        <div class="col-7">
                            @Model.TableId
                        </div>

                    </div>

                    <div class="row mb-2">

                        <div class="col-5 fw-bold">
                            Table Number:
                        </div>

                        <div class="col-7">
                            Table @Model.TableNumber
                        </div>

                    </div>

                    <div class="row mb-2">

                        <div class="col-5 fw-bold">
                            Capacity:
                        </div>

                        <div class="col-7">
                            @Model.Capacity Persons
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-5 fw-bold">
                            Status:
                        </div>

                        <div class="col-7">
                            @Model.Status
                        </div>

                    </div>

                </div>

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="TableId" />

                    <button type="submit"
                            class="btn btn-danger">
                        <i class="bi bi-trash"></i>
                        Yes, Delete
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i>
                        Cancel
                    </a>

                </form>

            </div>

        </div>

    </div>

</div>