@model IEnumerable<Restaurant_Management__System.Models.DiningTable>

@{
    ViewData["Title"] = "Dining Tables";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-table text-primary me-2"></i>Dining Tables
        </h2>
        <p class="text-muted mb-0">Manage restaurant seating capacity and table availability</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>
        Add Table
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Table Number</th>
                        <th>Capacity</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-primary">#@item.TableId</span>
                                </td>
                                <td>
                                    <strong class="text-dark">
                                        <i class="bi bi-grid-3x3 text-primary me-1"></i> Table @item.TableNumber
                                    </strong>
                                </td>
                                <td>
                                    <span class="text-muted">
                                        <i class="bi bi-people me-1"></i> @item.Capacity Persons
                                    </span>
                                </td>
                                <td>
                                    @if (item.Status == "Available")
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i> Available
                                        </span>
                                    }
                                    else if (item.Status == "Occupied")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-dash-circle me-1"></i> Occupied
                                        </span>
                                    }
                                    else if (item.Status == "Reserved")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-clock me-1"></i> Reserved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.TableId" class="btn btn-sm btn-outline-secondary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.TableId" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.TableId" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-table display-6 d-block mb-2 text-primary opacity-50"></i>
                                No dining tables configured yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>