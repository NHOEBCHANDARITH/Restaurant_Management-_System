@{
}
@model IEnumerable<Restaurant_Management__System.Models.DiningTable>

@{
    ViewData["Title"] = "Dining Tables";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold">Dining Tables</h2>
        <p class="text-muted">Manage restaurant dining tables</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>
        Add Table
    </a>
</div>

<div class="card">
    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Table Number</th>
                        <th>Capacity</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.TableId</td>

                            <td>
                                <strong>
                                    <i class="bi bi-table"></i>
                                    Table @item.TableNumber
                                </strong>
                            </td>

                            <td>
                                <i class="bi bi-people"></i>
                                @item.Capacity Persons
                            </td>

                            <td>
                                @if (item.Status == "Available")
                                {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                }
                                else if (item.Status == "Occupied")
                                {
                                    <span class="badge bg-danger">
                                        Occupied
                                    </span>
                                }
                                else if (item.Status == "Reserved")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Reserved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @item.Status
                                    </span>
                                }
                            </td>

                            <td class="text-end">

                                <a asp-action="Details"
                                   asp-route-id="@item.TableId"
                                   class="btn btn-sm btn-info text-white"
                                   title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.TableId"
                                   class="btn btn-sm btn-warning"
                                   title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.TableId"
                                   class="btn btn-sm btn-danger"
                                   title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>
</div>