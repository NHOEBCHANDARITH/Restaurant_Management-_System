@model Restaurant_Management__System.Models.DiningTable
@{
    ViewData["Title"] = "Table Details - " + Model.TableNumber;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="rms-card">
            <div class="rms-card-header bg-light">
                <h5 class="rms-card-title">
                    <i class="bi bi-info-circle text-warning"></i>
                    Dining Table Details
                </h5>
                <span class="badge bg-secondary">ID #@Model.TableId</span>
            </div>
            <div class="rms-card-body p-4 text-center">
                <div class="rms-table-visual-circle mx-auto my-3" style="width: 80px; height: 80px; font-size: 36px;">
                    <i class="bi bi-table"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Table @Model.TableNumber</h3>
                <p class="text-muted mb-4">Floor Seating Station</p>

                <div class="border rounded-3 p-3 bg-light text-start mb-4">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-people me-2"></i> Guest Capacity</span>
                        <strong class="text-dark">@Model.Capacity Persons</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted"><i class="bi bi-flag me-2"></i> Current Status</span>
                        <span>
                            @if (Model.Status == "Available")
                            {
                                <span class="rms-badge rms-badge-success"><span class="rms-badge-dot"></span> Available</span>
                            }
                            else if (Model.Status == "Occupied")
                            {
                                <span class="rms-badge rms-badge-danger"><span class="rms-badge-dot"></span> Occupied</span>
                            }
                            else if (Model.Status == "Reserved")
                            {
                                <span class="rms-badge rms-badge-warning"><span class="rms-badge-dot"></span> Reserved</span>
                            }
                            else
                            {
                                <span class="rms-badge rms-badge-info"><span class="rms-badge-dot"></span> @Model.Status</span>
                            }
                        </span>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.TableId" class="btn rms-btn-primary">
                        <i class="bi bi-pencil"></i> Edit Table
                    </a>
                    <a asp-controller="Orders" asp-action="Create" class="btn rms-btn-outline">
                        <i class="bi bi-plus-lg"></i> Create Order
                    </a>
                    <a asp-action="Index" class="btn rms-btn-secondary">Back to Tables</a>
                </div>
            </div>
        </div>
    </div>
</div>