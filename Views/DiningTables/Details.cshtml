@{
}
@model Restaurant_Management__System.Models.DiningTable

@{
    ViewData["Title"] = "Dining Table Details";
}

<div class="row justify-content-center">

    <div class="col-md-7">

        <div class="card">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h3 class="fw-bold mb-0">
                        <i class="bi bi-table text-info"></i>
                        Dining Table Details
                    </h3>

                    <span class="badge bg-primary">
                        ID: @Model.TableId
                    </span>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <small class="text-muted">
                            Table Number
                        </small>

                        <h5>
                            <i class="bi bi-table text-primary"></i>
                            Table @Model.TableNumber
                        </h5>

                    </div>

                    <div class="col-md-6 mb-4">

                        <small class="text-muted">
                            Capacity
                        </small>

                        <h5>
                            <i class="bi bi-people text-primary"></i>
                            @Model.Capacity Persons
                        </h5>

                    </div>

                    <div class="col-md-12 mb-4">

                        <small class="text-muted">
                            Status
                        </small>

                        <div class="mt-2">

                            @if (Model.Status == "Available")
                            {
                                <span class="badge bg-success fs-6">
                                    Available
                                </span>
                            }
                            else if (Model.Status == "Occupied")
                            {
                                <span class="badge bg-danger fs-6">
                                    Occupied
                                </span>
                            }
                            else if (Model.Status == "Reserved")
                            {
                                <span class="badge bg-warning text-dark fs-6">
                                    Reserved
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">
                                    @Model.Status
                                </span>
                            }

                        </div>

                    </div>

                </div>

                <hr />

                <div class="mt-3">

                    <a asp-action="Edit"
                       asp-route-id="@Model.TableId"
                       class="btn btn-warning">
                        <i class="bi bi-pencil"></i>
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.TableId"
                       class="btn btn-danger">
                        <i class="bi bi-trash"></i>
                        Delete
                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i>
                        Back
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>