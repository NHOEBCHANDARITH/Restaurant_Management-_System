@model Restaurant_Management__System.Models.DiningTable
@{
    ViewData["Title"] = "Edit Table " + Model.TableNumber;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="rms-form-card">
            <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                <div class="rms-brand-logo-icon" style="width: 44px; height: 44px; font-size: 20px;">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-dark mb-0">Edit Table @Model.TableNumber</h4>
                    <small class="text-muted">Update table capacity or operational status</small>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="TableId" />
                <div asp-validation-summary="ModelOnly" class="rms-alert rms-alert-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TableNumber" class="rms-form-label">
                        Table Number / Identifier <span class="required-dot">*</span>
                    </label>
                    <div class="rms-input-group">
                        <i class="bi bi-hash rms-input-icon"></i>
                        <input asp-for="TableNumber" class="rms-form-control" required />
                    </div>
                    <span asp-validation-for="TableNumber" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Capacity" class="rms-form-label">
                        Seating Capacity (Guests) <span class="required-dot">*</span>
                    </label>
                    <div class="rms-input-group">
                        <i class="bi bi-people rms-input-icon"></i>
                        <input asp-for="Capacity" type="number" min="1" max="50" class="rms-form-control" required />
                    </div>
                    <span asp-validation-for="Capacity" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Status" class="rms-form-label">Table Live Status</label>
                    <div class="rms-input-group">
                        <i class="bi bi-flag rms-input-icon"></i>
                        <select asp-for="Status" class="form-select rms-form-control">
                            <option value="Available">Available (Ready for Guests)</option>
                            <option value="Occupied">Occupied (Currently Dining)</option>
                            <option value="Reserved">Reserved (Advance Booking)</option>
                            <option value="Cleaning">Cleaning / Sanitizing</option>
                        </select>
                    </div>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn rms-btn-primary">
                        <i class="bi bi-check-lg"></i> Update Table
                    </button>
                    <a asp-action="Index" class="btn rms-btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}