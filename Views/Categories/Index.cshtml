@{
}
@model IEnumerable<Restaurant_Management__System.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">Categories</h2>
        <p class="text-muted mb-0">Manage food categories</p>
    </div>

    <a asp-action="Create" class="btn btn-dark">
        <i class="bi bi-plus-lg me-1"></i>
        Add Category
    </a>

</div>

<div class="row g-4">

    @foreach (var item in Model)
    {
        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">

            <div class="card h-100 border-0 shadow-sm category-card">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start mb-3">

                        <div class="category-icon">
                            <i class="bi bi-grid-fill"></i>
                        </div>

                        <span class="badge bg-light text-dark">
                            #@item.CategoryId
                        </span>

                    </div>

                    <h5 class="fw-bold mb-1">
                        @item.CategoryName
                    </h5>

                    <p class="text-muted small mb-4">
                        Food Category
                    </p>

                    <div class="d-flex gap-2">

                        <a asp-action="Details"
                           asp-route-id="@item.CategoryId"
                           class="btn btn-sm btn-outline-secondary flex-fill">
                            <i class="bi bi-eye me-1"></i>
                            View
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.CategoryId"
                           class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.CategoryId"
                           class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>

@if (!Model.Any())
{
    <div class="text-center py-5">

        <div class="mb-3">
            <i class="bi bi-grid fs-1 text-muted"></i>
        </div>

        <h5 class="fw-bold">
            No Categories Found
        </h5>

        <p class="text-muted">
            Start by creating your first food category.
        </p>

        <a asp-action="Create" class="btn btn-dark">
            <i class="bi bi-plus-lg me-1"></i>
            Add Category
        </a>

    </div>
}

<style>

    .category-card {
        border-radius: 16px;
        transition: all 0.25s ease;
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.10) !important;
        }

    .category-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #f1f3f5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        color: #212529;
    }

</style>