@model IEnumerable<Restaurant_Management__System.Models.Category>
@{
    ViewData["Title"] = "Food Categories";
    int count = Model?.Count() ?? 0;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-tags-fill text-warning me-2"></i>Food &amp; Beverage Categories
        </h2>
        <p class="text-muted mb-0">Organize dishes into culinary groups (Appetizers, Mains, Soups, Desserts, Drinks).</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn rms-btn-primary">
            <i class="bi bi-plus-lg"></i> Add Category
        </a>
    </div>
</div>

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="rms-card h-100 rms-searchable-card p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="rms-brand-logo-icon" style="width: 48px; height: 48px; font-size: 22px;">
                            <i class="bi bi-grid-fill"></i>
                        </div>
                        <span class="badge bg-light text-muted border font-monospace">#CAT-@item.CategoryId</span>
                    </div>

                    <h4 class="fw-bold text-dark mb-1">@item.CategoryName</h4>
                    <p class="text-muted small mb-4 flex-grow-1">
                        Culinary specialty section containing handcrafted authentic dishes and beverages.
                    </p>

                    <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                        <a asp-controller="MenuItems" asp-action="Index" class="small text-muted text-decoration-none">
                            <i class="bi bi-cup-hot text-warning me-1"></i> View Dishes
                        </a>

                        <div class="rms-action-btn-group">
                            <a asp-action="Details" asp-route-id="@item.CategoryId" class="rms-action-btn" title="View"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.CategoryId" class="rms-action-btn" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.CategoryId" class="rms-action-btn delete" title="Delete"><i class="bi bi-trash"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="rms-empty-state rms-card">
                <div class="rms-empty-icon"><i class="bi bi-tags"></i></div>
                <h4 class="rms-empty-title">No Categories Found</h4>
                <p class="rms-empty-desc">Create food categories such as "Appetizers", "Main Course", "Seafood", or "Desserts".</p>
                <a asp-action="Create" class="btn rms-btn-primary">
                    <i class="bi bi-plus-lg"></i> Add First Category
                </a>
            </div>
        </div>
    }
</div>