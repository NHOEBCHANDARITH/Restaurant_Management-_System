@model Restaurant_Management__System.Models.Category
@{
    ViewData["Title"] = "Category Details - " + Model.CategoryName;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="rms-card">
            <div class="rms-card-header bg-light">
                <h5 class="rms-card-title">
                    <i class="bi bi-tags text-warning"></i>
                    Food Category Details
                </h5>
                <span class="badge bg-secondary">#@Model.CategoryId</span>
            </div>
            <div class="rms-card-body p-4 text-center">
                <div class="rms-brand-logo-icon mx-auto my-3" style="width: 72px; height: 72px; font-size: 32px;">
                    <i class="bi bi-grid-fill"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">@Model.CategoryName</h3>
                <p class="text-muted mb-4">Official Menu Section</p>

                <div class="border rounded-3 p-3 bg-light text-start mb-4 small">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Category ID</span>
                        <strong class="text-dark font-monospace">#CAT-@Model.CategoryId</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Department</span>
                        <strong class="text-dark">Food &amp; Beverage Culinary Catalog</strong>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn rms-btn-primary">
                        <i class="bi bi-pencil"></i> Edit Category
                    </a>
                    <a asp-controller="MenuItems" asp-action="Index" class="btn rms-btn-outline">
                        <i class="bi bi-cup-hot"></i> Browse Dishes
                    </a>
                    <a asp-action="Index" class="btn rms-btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>