@{
}
@model Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="row justify-content-center">

    <div class="col-md-7">

        <div class="card p-4">

            <h3 class="fw-bold mb-4">
                <i class="bi bi-info-circle text-info"></i>
                Category Details
            </h3>

            <dl class="row">

                <dt class="col-sm-4">
                    Category ID
                </dt>

                <dd class="col-sm-8">
                    @Model.CategoryId
                </dd>

                <dt class="col-sm-4">
                    Category Name
                </dt>

                <dd class="col-sm-8">
                    @Model.CategoryName
                </dd>

            </dl>

            <div class="mt-3">

                <a asp-action="Edit"
                   asp-route-id="@Model.CategoryId"
                   class="btn btn-warning">
                    <i class="bi bi-pencil"></i>
                    Edit
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back
                </a>

            </div>

        </div>

    </div>

</div>