@model Restaurant_Management__System.Models.Category
@{
    ViewData["Title"] = "Edit Category " + Model.CategoryName;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="rms-form-card">
            <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                <div class="rms-brand-logo-icon" style="width: 44px; height: 44px; font-size: 20px;">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-dark mb-0">Edit Category: @Model.CategoryName</h4>
                    <small class="text-muted">Rename culinary section</small>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CategoryId" />
                <div asp-validation-summary="ModelOnly" class="rms-alert rms-alert-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="CategoryName" class="rms-form-label">
                        Category Name <span class="required-dot">*</span>
                    </label>
                    <div class="rms-input-group">
                        <i class="bi bi-tags rms-input-icon"></i>
                        <input asp-for="CategoryName" class="rms-form-control" required />
                    </div>
                    <span asp-validation-for="CategoryName" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn rms-btn-primary">
                        <i class="bi bi-check-lg"></i> Update Category
                    </button>
                    <a asp-action="Index" class="btn rms-btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}