@model IEnumerable<Restaurant_Management__System.Models.User>

@{
    ViewData["Title"] = "Staff Users";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-person-badge text-primary me-2"></i>Staff & System Users
        </h2>
        <p class="text-muted mb-0">Manage restaurant staff accounts, roles, and access credentials</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>
        Add User
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Full Name</th>
                        <th>Email Address</th>
                        <th>Phone Number</th>
                        <th>Role</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-secondary">#@item.UserId</span>
                                </td>
                                <td>
                                    <strong class="text-dark">
                                        <i class="bi bi-person-circle text-primary me-1"></i> @item.FullName
                                    </strong>
                                </td>
                                <td>
                                    <span class="text-muted"><i class="bi bi-envelope me-1"></i>@item.Email</span>
                                </td>
                                <td>
                                    <span class="text-muted"><i class="bi bi-telephone me-1"></i>@item.Phone</span>
                                </td>
                                <td>
                                    @if (item.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-shield-lock me-1"></i> Admin
                                        </span>
                                    }
                                    else if (item.Role == "Manager")
                                    {
                                        <span class="badge bg-primary">
                                            <i class="bi bi-award me-1"></i> Manager
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">
                                            <i class="bi bi-person me-1"></i> @item.Role
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-secondary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-people display-6 d-block mb-2 text-primary opacity-50"></i>
                                No users found in the system.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>