@{
}
@model Restaurant_Management__System.Models.OrderDetail

@{
    ViewData["Title"] = "Delete Order Detail";
}

<div class="row justify-content-center">

    <div class="col-md-8">

        <div class="card">

            <div class="card-body p-4 text-center">

                <i class="bi bi-exclamation-triangle-fill text-danger"
                   style="font-size:70px;">
                </i>

                <h3 class="fw-bold mt-3">
                    Delete Order Detail?
                </h3>

                <p class="text-muted">
                    Are you sure you want to delete this order detail?
                    This action cannot be undone.
                </p>

                <div class="alert alert-light text-start">

                    <div class="row mb-3">

                        <div class="col-5 fw-bold">
                            Detail ID:
                        </div>

                        <div class="col-7">
                            #@Model.DetailId
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-5 fw-bold">
                            Order:
                        </div>

                        <div class="col-7">
                            #@Model.OrderId
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-5 fw-bold">
                            Menu Item:
                        </div>

                        <div class="col-7">
                            @Model.MenuItem?.ItemName
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-5 fw-bold">
                            Quantity:
                        </div>

                        <div class="col-7">
                            @Model.Quantity
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-5 fw-bold">
                            Unit Price:
                        </div>

                        <div class="col-7">
                            $@Model.UnitPrice.ToString("N2")
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-5 fw-bold">
                            Subtotal:
                        </div>

                        <div class="col-7">
                            <strong class="text-success">
                                $@Model.Subtotal.ToString("N2")
                            </strong>
                        </div>

                    </div>

                </div>

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="DetailId" />

                    <button type="submit"
                            class="btn btn-danger">
                        <i class="bi bi-trash"></i>
                        Yes, Delete
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i>
                        Cancel
                    </a>

                </form>

            </div>

        </div>

    </div>

</div>