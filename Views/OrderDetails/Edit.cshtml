@{
}
@model Restaurant_Management__System.Models.OrderDetail

@{
    ViewData["Title"] = "Edit Order Detail";
}

<div class="row justify-content-center">

    <div class="col-md-8">

        <div class="card">

            <div class="card-body p-4">

                <h3 class="fw-bold mb-4">
                    <i class="bi bi-pencil-square text-warning"></i>
                    Edit Order Detail
                </h3>

                <form asp-action="Edit" method="post">

                    <input type="hidden"
                           asp-for="DetailId" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <!-- Order -->
                    <div class="mb-3">

                        <label asp-for="OrderId"
                               class="form-label">
                            Order
                        </label>

                        <select asp-for="OrderId"
                                class="form-select"
                                asp-items="ViewBag.OrderId">

                            <option value="">
                                -- Select Order --
                            </option>

                        </select>

                        <span asp-validation-for="OrderId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Menu Item -->
                    <div class="mb-3">

                        <label asp-for="ItemId"
                               class="form-label">
                            Menu Item
                        </label>

                        <select asp-for="ItemId"
                                class="form-select"
                                asp-items="ViewBag.ItemId">

                            <option value="">
                                -- Select Menu Item --
                            </option>

                        </select>

                        <span asp-validation-for="ItemId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Quantity -->
                    <div class="mb-3">

                        <label asp-for="Quantity"
                               class="form-label">
                            Quantity
                        </label>

                        <input asp-for="Quantity"
                               type="number"
                               min="1"
                               class="form-control" />

                        <span asp-validation-for="Quantity"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Unit Price -->
                    <div class="mb-3">

                        <label asp-for="UnitPrice"
                               class="form-label">
                            Unit Price
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                $
                            </span>

                            <input asp-for="UnitPrice"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" />

                        </div>

                        <span asp-validation-for="UnitPrice"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Subtotal -->
                    <div class="mb-3">

                        <label asp-for="Subtotal"
                               class="form-label">
                            Subtotal
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                $
                            </span>

                            <input asp-for="Subtotal"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" />

                        </div>

                        <span asp-validation-for="Subtotal"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mt-4">

                        <button type="submit"
                                class="btn btn-warning">
                            <i class="bi bi-check-circle"></i>
                            Update
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i>
                            Back
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}