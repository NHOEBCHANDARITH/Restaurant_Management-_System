@model IEnumerable<Restaurant_Management__System.Models.OrderDetail>

@{
    ViewData["Title"] = "Order Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-list-check text-primary me-2"></i>Order Details
        </h2>
        <p class="text-muted mb-0">Manage order items, portion quantities, and line item totals</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>
        Add Item to Order
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Detail ID</th>
                        <th>Order</th>
                        <th>Menu Item</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Subtotal</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-secondary">#@item.DetailId</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary">
                                        <i class="bi bi-receipt me-1"></i> Order #@item.OrderId
                                    </span>
                                </td>
                                <td>
                                    <strong class="text-dark">
                                        <i class="bi bi-cup-hot text-primary me-1"></i>
                                        @item.MenuItem?.ItemName
                                    </strong>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        x @item.Quantity
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted font-monospace">$@item.UnitPrice.ToString("N2")</span>
                                </td>
                                <td>
                                    <strong class="text-primary font-monospace">
                                        $@item.Subtotal.ToString("N2")
                                    </strong>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.DetailId" class="btn btn-sm btn-outline-secondary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.DetailId" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.DetailId" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-card-list display-6 d-block mb-2 text-primary opacity-50"></i>
                                No order details recorded.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>