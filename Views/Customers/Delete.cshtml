@model Restaurant_Management__System.Models.Customer
@{
    ViewData["Title"] = "Delete Customer " + Model.CustomerName;
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="rms-card">
            <div class="rms-card-body p-4 text-center">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" 
                     style="width: 72px; height: 72px; background: rgba(239, 68, 68, 0.12); color: #ef4444; font-size: 32px;">
                    <i class="bi bi-person-x-fill"></i>
                </div>

                <h4 class="fw-bold text-dark mb-1">Delete Customer Record?</h4>
                <p class="text-muted small mb-4">
                    Are you sure you want to delete <strong class="text-dark">@Model.CustomerName</strong>? 
                    Their past bookings and dining orders will lose customer profile linkage.
                </p>

                <div class="border rounded-3 p-3 bg-light text-start mb-4 small">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Customer Name</span>
                        <strong class="text-dark">@Model.CustomerName</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Phone</span>
                        <strong class="text-dark">@Model.Phone</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Address</span>
                        <strong class="text-dark">@Model.Address</strong>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CustomerId" />
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Index" class="btn rms-btn-secondary">Cancel</a>
                        <button type="submit" class="btn rms-btn-danger">
                            <i class="bi bi-trash"></i> Yes, Delete Customer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>