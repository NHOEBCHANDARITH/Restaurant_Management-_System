@model Restaurant_Management__System.Models.Customer
@{
    ViewData["Title"] = "Customer Profile - " + Model.CustomerName;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="rms-card">
            <div class="rms-card-header bg-light">
                <h5 class="rms-card-title">
                    <i class="bi bi-person-circle text-warning"></i>
                    Customer Profile
                </h5>
                <span class="badge bg-secondary font-monospace">#CUST-@Model.CustomerId</span>
            </div>
            <div class="rms-card-body p-4 text-center">
                <div class="rms-user-avatar mx-auto my-3" style="width: 80px; height: 80px; font-size: 32px; border: 3px solid rgba(217, 119, 6, 0.4);">
                    @(string.IsNullOrEmpty(Model.CustomerName) ? "G" : Model.CustomerName.Substring(0, 1).ToUpper())
                </div>
                <h3 class="fw-bold text-dark mb-1">@Model.CustomerName</h3>
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill mb-4">
                    <i class="bi bi-star-fill me-1" style="font-size: 10px;"></i> Valued Guest
                </span>

                <div class="border rounded-3 p-3 bg-light text-start mb-4 small">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-telephone me-2"></i> Contact Phone</span>
                        <strong class="text-dark">@(string.IsNullOrEmpty(Model.Phone) ? "Not provided" : Model.Phone)</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-geo-alt me-2"></i> Address</span>
                        <strong class="text-dark">@(string.IsNullOrEmpty(Model.Address) ? "Phnom Penh, Cambodia" : Model.Address)</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted"><i class="bi bi-clock me-2"></i> Dining History</span>
                        <strong class="text-success"><i class="bi bi-check-circle me-1"></i> Active Diner</strong>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn rms-btn-primary">
                        <i class="bi bi-pencil"></i> Edit Profile
                    </a>
                    <a asp-controller="Reservations" asp-action="Create" class="btn rms-btn-outline">
                        <i class="bi bi-calendar-plus"></i> Book Table
                    </a>
                    <a asp-action="Index" class="btn rms-btn-secondary">Back to Directory</a>
                </div>
            </div>
        </div>
    </div>
</div>