@model Restaurant_Management__System.Models.Customer
@{
    ViewData["Title"] = "Edit Customer - " + Model.CustomerName;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="rms-form-card">
            <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                <div class="rms-brand-logo-icon" style="width: 44px; height: 44px; font-size: 20px;">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-dark mb-0">Edit Guest: @Model.CustomerName</h4>
                    <small class="text-muted">Update customer contact or address details</small>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CustomerId" />
                <div asp-validation-summary="ModelOnly" class="rms-alert rms-alert-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CustomerName" class="rms-form-label">
                        Guest Full Name <span class="required-dot">*</span>
                    </label>
                    <div class="rms-input-group">
                        <i class="bi bi-person rms-input-icon"></i>
                        <input asp-for="CustomerName" class="rms-form-control" required />
                    </div>
                    <span asp-validation-for="CustomerName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="rms-form-label">
                        Phone Contact <span class="required-dot">*</span>
                    </label>
                    <div class="rms-input-group">
                        <i class="bi bi-telephone rms-input-icon"></i>
                        <input asp-for="Phone" class="rms-form-control" required />
                    </div>
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Address" class="rms-form-label">Address / District</label>
                    <div class="rms-input-group">
                        <i class="bi bi-geo-alt rms-input-icon"></i>
                        <input asp-for="Address" class="rms-form-control" />
                    </div>
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn rms-btn-primary">
                        <i class="bi bi-check-lg"></i> Update Guest
                    </button>
                    <a asp-action="Index" class="btn rms-btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}