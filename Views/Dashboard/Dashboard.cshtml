@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Restaurant Dashboard
        </h2>
        <p class="text-muted mb-0">Overview of today's sales, active tables, orders, and reservations</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Orders" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> New Order
        </a>
        <a asp-controller="Reservations" asp-action="Create" class="btn btn-outline-primary">
            <i class="bi bi-calendar-plus me-1"></i> Book Table
        </a>
    </div>
</div>

<!-- STAT CARDS -->
<div class="row g-4 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted small mb-1 fw-semibold text-uppercase">Total Customers</p>
                    <h3 class="fw-bold mb-1 text-dark">1,250</h3>
                    <small class="text-success fw-semibold">
                        <i class="bi bi-arrow-up-right me-1"></i>+12% this month
                    </small>
                </div>
                <div class="stat-icon" style="background: rgba(72, 190, 218, 0.12); color: #48beda;">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted small mb-1 fw-semibold text-uppercase">Today's Orders</p>
                    <h3 class="fw-bold mb-1 text-dark">86</h3>
                    <small class="text-success fw-semibold">
                        <i class="bi bi-arrow-up-right me-1"></i>+8% vs yesterday
                    </small>
                </div>
                <div class="stat-icon" style="background: #dcfce7; color: #15803d;">
                    <i class="bi bi-receipt"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted small mb-1 fw-semibold text-uppercase">Reservations</p>
                    <h3 class="fw-bold mb-1 text-dark">32</h3>
                    <small class="text-primary fw-semibold">
                        <i class="bi bi-clock me-1"></i>6 upcoming today
                    </small>
                </div>
                <div class="stat-icon" style="background: #fef3c7; color: #b45309;">
                    <i class="bi bi-calendar-check"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted small mb-1 fw-semibold text-uppercase">Today's Revenue</p>
                    <h3 class="fw-bold mb-1 text-dark">$8,540</h3>
                    <small class="text-success fw-semibold">
                        <i class="bi bi-arrow-up-right me-1"></i>+15% target
                    </small>
                </div>
                <div class="stat-icon" style="background: rgba(72, 190, 218, 0.15); color: #0891b2;">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ORDERS & RESERVATIONS OVERVIEW -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h5 class="fw-bold mb-0 text-dark">Recent Orders</h5>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-primary">
                    View All Orders <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Order ID</th>
                                <th>Customer</th>
                                <th>Table</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-4"><span class="badge bg-primary">#ORD001</span></td>
                                <td><strong class="text-dark">John Smith</strong></td>
                                <td><span class="text-muted">Table T-05</span></td>
                                <td><strong class="text-primary font-monospace">$45.00</strong></td>
                                <td><span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Completed</span></td>
                            </tr>
                            <tr>
                                <td class="ps-4"><span class="badge bg-primary">#ORD002</span></td>
                                <td><strong class="text-dark">Dara Sok</strong></td>
                                <td><span class="text-muted">Table T-02</span></td>
                                <td><strong class="text-primary font-monospace">$32.50</strong></td>
                                <td><span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Pending</span></td>
                            </tr>
                            <tr>
                                <td class="ps-4"><span class="badge bg-primary">#ORD003</span></td>
                                <td><strong class="text-dark">Sokha Meng</strong></td>
                                <td><span class="text-muted">Table T-08</span></td>
                                <td><strong class="text-primary font-monospace">$75.00</strong></td>
                                <td><span class="badge bg-primary"><i class="bi bi-fire me-1"></i> Preparing</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h5 class="fw-bold mb-0 text-dark">Today's Schedule</h5>
                <a asp-controller="Reservations" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    View
                </a>
            </div>
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                    <div>
                        <strong class="text-dark d-block">12:00 PM</strong>
                        <small class="text-muted"><i class="bi bi-table text-primary me-1"></i>Table T-03 • 4 Guests</small>
                    </div>
                    <span class="badge bg-success">Confirmed</span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                    <div>
                        <strong class="text-dark d-block">01:30 PM</strong>
                        <small class="text-muted"><i class="bi bi-table text-primary me-1"></i>Table T-06 • 2 Guests</small>
                    </div>
                    <span class="badge bg-warning text-dark">Pending</span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong class="text-dark d-block">07:00 PM</strong>
                        <small class="text-muted"><i class="bi bi-table text-primary me-1"></i>Table T-10 • 6 Guests</small>
                    </div>
                    <span class="badge bg-success">Confirmed</span>
                </div>
            </div>
        </div>
    </div>
</div>