@{
    ViewData["Title"] = "Executive Dashboard";
    
    decimal totalRevenue = ViewBag.TotalRevenue ?? 0m;
    int totalOrders = ViewBag.TotalOrders ?? 0;
    int pendingOrders = ViewBag.PendingOrders ?? 0;
    int completedOrders = ViewBag.CompletedOrders ?? 0;
    int totalCustomers = ViewBag.TotalCustomers ?? 0;
    int todayReservations = ViewBag.TodayReservations ?? 0;
    int totalTables = ViewBag.TotalTables ?? 0;
    int availableTables = ViewBag.AvailableTables ?? 0;
    int occupiedTables = ViewBag.OccupiedTables ?? 0;
    int reservedTables = ViewBag.ReservedTables ?? 0;
    int lowStockCount = ViewBag.LowStockCount ?? 0;
    int totalMenuItems = ViewBag.TotalMenuItems ?? 0;

    var recentOrders = ViewBag.RecentOrders as List<Restaurant_Management__System.Models.Order> ?? new List<Restaurant_Management__System.Models.Order>();
    var recentReservations = ViewBag.RecentReservations as List<Restaurant_Management__System.Models.Reservation> ?? new List<Restaurant_Management__System.Models.Reservation>();
    var lowStockItems = ViewBag.LowStockItems as List<Restaurant_Management__System.Models.Inventory> ?? new List<Restaurant_Management__System.Models.Inventory>();
}

<!-- TOP WELCOME BANNER & QUICK ACTIONS -->
<div class="row align-items-center g-3 mb-4">
    <div class="col-md-7">
        <h2 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
            <span>Sovannaphum Overview</span>
            <span class="badge bg-warning text-dark fs-6 rounded-pill">Live Service</span>
        </h2>
        <p class="text-muted mb-0">Real-time restaurant operations, active dining tables, orders, and inventory analytics.</p>
    </div>
    <div class="col-md-5 text-md-end">
        <div class="d-inline-flex gap-2 flex-wrap">
            <a asp-controller="Orders" asp-action="Create" class="btn rms-btn-primary">
                <i class="bi bi-plus-circle"></i> New Order
            </a>
            <a asp-controller="Reservations" asp-action="Create" class="btn rms-btn-secondary">
                <i class="bi bi-calendar-plus"></i> Reserve Table
            </a>
            <a asp-controller="Reports" asp-action="Index" class="btn rms-btn-secondary">
                <i class="bi bi-bar-chart"></i> Reports
            </a>
        </div>
    </div>
</div>

<!-- KPI SUMMARY STATS -->
<div class="row g-3 mb-4">
    <!-- Total Revenue -->
    <div class="col-xl-3 col-md-6">
        <div class="rms-stat-card">
            <div>
                <div class="rms-stat-label">Total Revenue</div>
                <div class="rms-stat-value text-dark">$@totalRevenue.ToString("N2")</div>
                <div class="rms-stat-subtext text-success">
                    <i class="bi bi-arrow-up-right"></i>
                    <span>@((totalRevenue * 4100).ToString("N0")) ៛ (KHR)</span>
                </div>
            </div>
            <div class="rms-stat-icon-wrapper rms-icon-gold">
                <i class="bi bi-currency-dollar"></i>
            </div>
        </div>
    </div>

    <!-- Total Orders -->
    <div class="col-xl-3 col-md-6">
        <div class="rms-stat-card">
            <div>
                <div class="rms-stat-label">Total Orders</div>
                <div class="rms-stat-value text-dark">@totalOrders</div>
                <div class="rms-stat-subtext text-primary">
                    <i class="bi bi-hourglass-split"></i>
                    <span>@pendingOrders Pending / Prep</span>
                </div>
            </div>
            <div class="rms-stat-icon-wrapper rms-icon-blue">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
        </div>
    </div>

    <!-- Active Reservations -->
    <div class="col-xl-3 col-md-6">
        <div class="rms-stat-card">
            <div>
                <div class="rms-stat-label">Reservations</div>
                <div class="rms-stat-value text-dark">@todayReservations</div>
                <div class="rms-stat-subtext text-warning">
                    <i class="bi bi-calendar-check"></i>
                    <span>Scheduled Bookings</span>
                </div>
            </div>
            <div class="rms-stat-icon-wrapper rms-icon-purple">
                <i class="bi bi-calendar2-week"></i>
            </div>
        </div>
    </div>

    <!-- Available Tables -->
    <div class="col-xl-3 col-md-6">
        <div class="rms-stat-card">
            <div>
                <div class="rms-stat-label">Dining Tables</div>
                <div class="rms-stat-value text-dark">@availableTables <span class="fs-6 text-muted fw-normal">/ @totalTables</span></div>
                <div class="rms-stat-subtext text-success">
                    <i class="bi bi-check-circle"></i>
                    <span>@availableTables Tables Ready</span>
                </div>
            </div>
            <div class="rms-stat-icon-wrapper rms-icon-emerald">
                <i class="bi bi-table"></i>
            </div>
        </div>
    </div>
</div>

<!-- SECONDARY KPI ROW -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="rms-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 p-3 bg-light text-primary fs-3">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <small class="text-muted fw-bold text-uppercase d-block">Registered Guests</small>
                <h4 class="fw-bold mb-0 text-dark">@totalCustomers</h4>
            </div>
            <a asp-controller="Customers" asp-action="Index" class="btn btn-sm rms-btn-secondary ms-auto">Directory</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="rms-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 p-3 bg-light text-warning fs-3">
                <i class="bi bi-cup-hot-fill"></i>
            </div>
            <div>
                <small class="text-muted fw-bold text-uppercase d-block">Menu Specialties</small>
                <h4 class="fw-bold mb-0 text-dark">@totalMenuItems Dishes</h4>
            </div>
            <a asp-controller="MenuItems" asp-action="Index" class="btn btn-sm rms-btn-secondary ms-auto">Menu</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="rms-card p-3 d-flex align-items-center gap-3">
            <div class="rounded-3 p-3 @(lowStockCount > 0 ? "bg-danger bg-opacity-10 text-danger" : "bg-success bg-opacity-10 text-success") fs-3">
                <i class="bi bi-boxes"></i>
            </div>
            <div>
                <small class="text-muted fw-bold text-uppercase d-block">Stock Alerts</small>
                <h4 class="fw-bold mb-0 @(lowStockCount > 0 ? "text-danger" : "text-success")">
                    @(lowStockCount > 0 ? $"{lowStockCount} Low Items" : "Stock Healthy")
                </h4>
            </div>
            <a asp-controller="Inventories" asp-action="Index" class="btn btn-sm rms-btn-secondary ms-auto">Inventory</a>
        </div>
    </div>
</div>

<!-- CHARTS ROW -->
<div class="row g-4 mb-4">
    <!-- Revenue & Sales Performance Chart -->
    <div class="col-lg-8">
        <div class="rms-card h-100">
            <div class="rms-card-header">
                <h5 class="rms-card-title">
                    <i class="bi bi-graph-up-arrow text-warning"></i>
                    Revenue &amp; Orders Trend
                </h5>
                <span class="badge bg-light text-muted border">Daily Dining Service</span>
            </div>
            <div class="rms-card-body">
                <canvas id="rmsSalesChart" height="260"></canvas>
            </div>
        </div>
    </div>

    <!-- Table Occupancy & Status Doughnut -->
    <div class="col-lg-4">
        <div class="rms-card h-100">
            <div class="rms-card-header">
                <h5 class="rms-card-title">
                    <i class="bi bi-pie-chart text-primary"></i>
                    Table Seating Status
                </h5>
                <a asp-controller="DiningTables" asp-action="Index" class="btn btn-sm rms-btn-secondary py-1">View Floor</a>
            </div>
            <div class="rms-card-body d-flex flex-column align-items-center justify-content-center">
                <div style="width: 220px; height: 220px; position: relative;">
                    <canvas id="rmsTablesChart"></canvas>
                </div>
                <div class="d-flex justify-content-center gap-3 mt-4 text-center">
                    <div>
                        <span class="d-inline-block rounded-circle bg-success me-1" style="width: 8px; height: 8px;"></span>
                        <small class="text-muted d-block">Available</small>
                        <strong class="text-dark">@availableTables</strong>
                    </div>
                    <div>
                        <span class="d-inline-block rounded-circle bg-danger me-1" style="width: 8px; height: 8px;"></span>
                        <small class="text-muted d-block">Occupied</small>
                        <strong class="text-dark">@occupiedTables</strong>
                    </div>
                    <div>
                        <span class="d-inline-block rounded-circle bg-warning me-1" style="width: 8px; height: 8px;"></span>
                        <small class="text-muted d-block">Reserved</small>
                        <strong class="text-dark">@reservedTables</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- RECENT ORDERS & RESERVATIONS SCHEDULE -->
<div class="row g-4">
    <!-- Recent Orders -->
    <div class="col-lg-8">
        <div class="rms-card h-100">
            <div class="rms-card-header">
                <h5 class="rms-card-title">
                    <i class="bi bi-receipt text-warning"></i>
                    Recent Dining Orders
                </h5>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-sm rms-btn-secondary">
                    View All Orders <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="rms-table-wrapper border-0 rounded-0">
                <div class="table-responsive">
                    <table class="rms-table align-middle">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Guest</th>
                                <th>Table</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentOrders.Any())
                            {
                                foreach (var order in recentOrders)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge rms-badge-primary">#@order.OrderId</span>
                                        </td>
                                        <td>
                                            <strong class="text-dark">@(order.Customer?.CustomerName ?? "Walk-in Guest")</strong>
                                        </td>
                                        <td>
                                            <span class="text-muted">
                                                <i class="bi bi-table text-warning me-1"></i>
                                                @(order.DiningTable != null ? $"Table {order.DiningTable.TableNumber}" : "Takeaway")
                                            </span>
                                        </td>
                                        <td>
                                            <strong class="text-dark font-monospace">$@order.TotalAmount.ToString("N2")</strong>
                                        </td>
                                        <td>
                                            @if (order.Status == "Completed")
                                            {
                                                <span class="rms-badge rms-badge-success"><span class="rms-badge-dot"></span> Completed</span>
                                            }
                                            else if (order.Status == "Pending")
                                            {
                                                <span class="rms-badge rms-badge-warning"><span class="rms-badge-dot"></span> Pending</span>
                                            }
                                            else if (order.Status == "Preparing" || order.Status == "Processing")
                                            {
                                                <span class="rms-badge rms-badge-info"><span class="rms-badge-dot"></span> Preparing</span>
                                            }
                                            else if (order.Status == "Cancelled")
                                            {
                                                <span class="rms-badge rms-badge-danger"><span class="rms-badge-dot"></span> Cancelled</span>
                                            }
                                            else
                                            {
                                                <span class="rms-badge rms-badge-secondary"><span class="rms-badge-dot"></span> @order.Status</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.OrderId" 
                                               class="btn btn-sm rms-btn-secondary py-1 px-2" title="View Bill">
                                                <i class="bi bi-receipt"></i> Bill
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        <i class="bi bi-receipt fs-3 d-block mb-1 opacity-50"></i>
                                        No recent orders placed yet.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Today's Schedule & Low Stock Alerts -->
    <div class="col-lg-4">
        <!-- Upcoming Reservations Card -->
        <div class="rms-card mb-4">
            <div class="rms-card-header">
                <h5 class="rms-card-title">
                    <i class="bi bi-clock-history text-primary"></i>
                    Today's Bookings
                </h5>
                <a asp-controller="Reservations" asp-action="Index" class="btn btn-sm rms-btn-secondary py-1">All</a>
            </div>
            <div class="rms-card-body p-3">
                @if (recentReservations.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var res in recentReservations.Take(3))
                        {
                            <div class="list-group-item px-0 py-3 border-bottom d-flex align-items-center justify-content-between">
                                <div>
                                    <strong class="text-dark d-block">@(res.Customer?.CustomerName ?? "Reserved Guest")</strong>
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i>@res.ReservationDate.ToString("hh:mm tt") • 
                                        <i class="bi bi-people ms-1 me-1"></i>@res.Guests guests
                                    </small>
                                </div>
                                <span class="badge @(res.Status == "Confirmed" ? "bg-success" : "bg-warning text-dark")">
                                    @res.Status
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-calendar-check fs-3 d-block mb-1 opacity-50"></i>
                        No reservations scheduled today.
                    </div>
                }
            </div>
        </div>

        <!-- Low Stock Items Warning -->
        <div class="rms-card">
            <div class="rms-card-header bg-light">
                <h5 class="rms-card-title text-danger fs-6">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    Kitchen Low Stock Alert
                </h5>
                <a asp-controller="Inventories" asp-action="Index" class="btn btn-sm btn-outline-danger py-0 px-2">Restock</a>
            </div>
            <div class="rms-card-body p-3">
                @if (lowStockItems.Any())
                {
                    @foreach (var item in lowStockItems)
                    {
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                            <div>
                                <strong class="text-dark small d-block">@(item.Ingredient?.IngredientName ?? "Ingredient #" + item.IngredientId)</strong>
                                <small class="text-muted">Stock level warning</small>
                            </div>
                            <span class="badge bg-danger rounded-pill">
                                @item.Quantity left
                            </span>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-3 text-success small">
                        <i class="bi bi-check-circle fs-4 d-block mb-1"></i>
                        All ingredients have adequate stock.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Sales Trend Line Chart
            const ctxSales = document.getElementById('rmsSalesChart');
            if (ctxSales) {
                new Chart(ctxSales, {
                    type: 'line',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Today'],
                        datasets: [{
                            label: 'Revenue ($)',
                            data: [350, 480, 420, 690, 850, 1120, @(totalRevenue > 0 ? totalRevenue : 850)],
                            borderColor: '#d97706',
                            backgroundColor: 'rgba(217, 119, 6, 0.1)',
                            fill: true,
                            tension: 0.35,
                            borderWidth: 3,
                            pointBackgroundColor: '#d97706',
                            pointRadius: 4
                        },
                        {
                            label: 'Orders Count',
                            data: [15, 22, 18, 30, 42, 58, @(totalOrders > 0 ? totalOrders : 45)],
                            borderColor: '#0284c7',
                            backgroundColor: 'transparent',
                            borderDash: [5, 5],
                            tension: 0.35,
                            borderWidth: 2,
                            pointBackgroundColor: '#0284c7',
                            yAxisID: 'y1'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: 'rgba(0, 0, 0, 0.05)' },
                                ticks: { callback: value => '$' + value }
                            },
                            y1: {
                                position: 'right',
                                beginAtZero: true,
                                grid: { display: false }
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
            }

            // 2. Dining Tables Status Doughnut Chart
            const ctxTables = document.getElementById('rmsTablesChart');
            if (ctxTables) {
                new Chart(ctxTables, {
                    type: 'doughnut',
                    data: {
                        labels: ['Available', 'Occupied', 'Reserved'],
                        datasets: [{
                            data: [@availableTables, @occupiedTables, @reservedTables],
                            backgroundColor: ['#10b981', '#ef4444', '#f59e0b'],
                            borderWidth: 3,
                            borderColor: '#ffffff',
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        cutout: '72%'
                    }
                });
            }
        });
    </script>
}