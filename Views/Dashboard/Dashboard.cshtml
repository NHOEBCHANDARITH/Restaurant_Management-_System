@{
    ViewData["Title"] = "Dashboard Overview";
}

<!-- Dashboard Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">Welcome back, Admin! 👋</h2>
        <p class="text-muted mb-0">Here's what's happening at the restaurant today, @DateTime.Now.ToString("MMMM dd, yyyy").</p>
    </div>
    <div>
        <a asp-controller="Orders" asp-action="Create" class="btn btn-primary rounded-3 shadow-sm px-4 py-2 fw-semibold" style="background: linear-gradient(135deg, #48beda 0%, #2099b5 100%); border: none;">
            <i class="bi bi-plus-lg me-1"></i> New POS Order
        </a>
    </div>
</div>

<!-- Key Metrics Row -->
<div class="row g-4 mb-4">
    <!-- Revenue Card -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 rounded-4 shadow-sm h-100">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted fw-semibold mb-2">Total Sales</h6>
                    <h3 class="fw-bold mb-0 text-dark">
                        @if (ViewBag.TotalRevenue != null) {
                            @(((decimal)ViewBag.TotalRevenue).ToString("C"))
                        } else {
                            <span>$0.00</span>
                        }
                    </h3>
                </div>
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; font-size: 24px;">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Orders Card -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 rounded-4 shadow-sm h-100">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted fw-semibold mb-2">Active Orders</h6>
                    <h3 class="fw-bold mb-0 text-dark">@(ViewBag.PendingOrders ?? 0)</h3>
                </div>
                <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; font-size: 24px;">
                    <i class="bi bi-receipt"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Tables Card -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 rounded-4 shadow-sm h-100">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted fw-semibold mb-2">Available Tables</h6>
                    <h3 class="fw-bold mb-0 text-dark">
                        @(ViewBag.AvailableTables ?? 0) <span class="fs-6 text-muted fw-normal">/ @(ViewBag.TotalTables ?? 0)</span>
                    </h3>
                </div>
                <div class="rounded-circle bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; font-size: 24px;">
                    <i class="bi bi-grid-3x3-gap"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Low Stock Card -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 rounded-4 shadow-sm h-100">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted fw-semibold mb-2">Low Stock Alerts</h6>
                    <h3 class="fw-bold mb-0 text-dark">@(ViewBag.LowStockCount ?? 0)</h3>
                </div>
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; font-size: 24px;">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dual Panels Row -->
<div class="row g-4">
    <!-- Left Panel: Recent Orders -->
    <div class="col-lg-8">
        <div class="card border-0 rounded-4 shadow-sm h-100">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0">Recent Orders</h5>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-light text-primary fw-semibold rounded-pill px-3">View All</a>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted">
                            <tr>
                                <th class="border-0 rounded-start-2">Order ID</th>
                                <th class="border-0">Customer</th>
                                <th class="border-0">Amount</th>
                                <th class="border-0">Status</th>
                                <th class="border-0 rounded-end-2">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.RecentOrders != null && ViewBag.RecentOrders.Count > 0)
                            {
                                foreach (var order in ViewBag.RecentOrders)
                                {
                                    <tr>
                                        <td class="fw-semibold text-primary">#@order.OrderId</td>
                                        <td>
                                            @if(order.Customer != null)
                                            {
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="bg-light rounded-circle text-center d-flex align-items-center justify-content-center text-muted" style="width: 32px; height: 32px; font-size: 12px; font-weight: 600;">
                                                        @(order.Customer.CustomerName.Substring(0, 1).ToUpper())
                                                    </div>
                                                    <span class="fw-medium">@order.Customer.CustomerName</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted fw-medium"><i class="bi bi-person-fill text-black-50 me-1"></i> Walk-in Guest</span>
                                            }
                                        </td>
                                        <td class="fw-semibold">@order.TotalAmount.ToString("C")</td>
                                        <td>
                                            @if (order.Status == "Completed")
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 border border-success border-opacity-25">Completed</span>
                                            }
                                            else if (order.Status == "Pending" || order.Status == "Preparing")
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2 border border-warning border-opacity-25">@order.Status</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 border border-secondary border-opacity-25">@order.Status</span>
                                            }
                                        </td>
                                        <td class="text-muted small">@order.OrderDate.ToString("MMM dd, hh:mm tt")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-5">
                                        <i class="bi bi-receipt fs-1 text-black-50 mb-2 d-block"></i>
                                        No recent orders found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Panel: Floor & Reservations -->
    <div class="col-lg-4">
        <div class="card border-0 rounded-4 shadow-sm h-100">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                <h5 class="fw-bold text-dark mb-0">Floor Status</h5>
            </div>
            <div class="card-body p-4">
                
                <div class="d-flex justify-content-between mb-4 text-center gap-3">
                    <div class="p-3 bg-light rounded-4 flex-fill border">
                        <h4 class="text-danger fw-bold mb-1">@(ViewBag.OccupiedTables ?? 0)</h4>
                        <span class="small text-muted fw-semibold">Occupied</span>
                    </div>
                    <div class="p-3 bg-light rounded-4 flex-fill border">
                        <h4 class="text-primary fw-bold mb-1">@(ViewBag.ReservedTables ?? 0)</h4>
                        <span class="small text-muted fw-semibold">Reserved</span>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-3 mt-4 d-flex justify-content-between align-items-center">
                    Upcoming Reservations
                    <span class="badge bg-primary rounded-pill">@(ViewBag.TodayReservations ?? 0) Today</span>
                </h6>
                
                <div class="list-group list-group-flush rounded-3 border">
                    @if (ViewBag.RecentReservations != null && ViewBag.RecentReservations.Count > 0)
                    {
                        foreach (var res in ViewBag.RecentReservations)
                        {
                            <div class="list-group-item px-3 py-3 border-bottom d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="mb-1 fw-bold text-dark">@res.Customer?.CustomerName</h6>
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i> @res.ReservationDate.ToString("hh:mm tt")
                                        &bull; <i class="bi bi-people ms-1 me-1"></i> @res.Guests guests
                                    </small>
                                </div>
                                <span class="badge bg-light text-dark border px-2 py-1 shadow-sm">Table @res.DiningTable?.TableNumber</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="list-group-item text-center text-muted py-4 bg-light">
                            <i class="bi bi-calendar-x fs-4 d-block mb-2 text-black-50"></i>
                            No upcoming reservations today.
                        </div>
                    }
                </div>
                
                <div class="text-center mt-4">
                    <a asp-controller="Reservations" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-4 fw-semibold">View All Reservations</a>
                </div>
            </div>
        </div>
    </div>
</div>