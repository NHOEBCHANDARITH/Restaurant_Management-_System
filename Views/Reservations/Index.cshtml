@model IEnumerable<Restaurant_Management__System.Models.Reservation>
@{
    ViewData["Title"] = "Reservations";

    int totalCount = Model?.Count() ?? 0;
    int confirmedCount = Model?.Count(r => r.Status == "Confirmed") ?? 0;
    int pendingCount = Model?.Count(r => r.Status == "Pending") ?? 0;
    int todayCount = Model?.Count(r => r.ReservationDate.Date == DateTime.Today) ?? 0;
}

<!-- HEADER -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-calendar2-check-fill text-warning me-2"></i>Guest Reservations &amp; Bookings
        </h2>
        <p class="text-muted mb-0">Manage upcoming table reservations, guest counts, and booking confirmations.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn rms-btn-primary">
            <i class="bi bi-calendar-plus"></i> New Reservation
        </a>
    </div>
</div>

<!-- STATS PILLS -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded-3 d-flex align-items-center gap-3 shadow-sm">
            <div class="rounded-circle p-2 bg-warning bg-opacity-10 text-warning fs-4">
                <i class="bi bi-calendar-event"></i>
            </div>
            <div>
                <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Total Bookings</small>
                <h4 class="fw-bold text-dark mb-0">@totalCount</h4>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded-3 d-flex align-items-center gap-3 shadow-sm">
            <div class="rounded-circle p-2 bg-success bg-opacity-10 text-success fs-4">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Confirmed</small>
                <h4 class="fw-bold text-dark mb-0">@confirmedCount</h4>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded-3 d-flex align-items-center gap-3 shadow-sm">
            <div class="rounded-circle p-2 bg-primary bg-opacity-10 text-primary fs-4">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div>
                <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Pending Approval</small>
                <h4 class="fw-bold text-dark mb-0">@pendingCount</h4>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded-3 d-flex align-items-center gap-3 shadow-sm">
            <div class="rounded-circle p-2 bg-info bg-opacity-10 text-info fs-4">
                <i class="bi bi-clock"></i>
            </div>
            <div>
                <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Today's Schedule</small>
                <h4 class="fw-bold text-dark mb-0">@todayCount</h4>
            </div>
        </div>
    </div>
</div>

<!-- RESERVATION TABLE -->
<div class="rms-table-wrapper">
    <div class="table-responsive">
        <table class="rms-table align-middle">
            <thead>
                <tr>
                    <th class="ps-4">Booking #</th>
                    <th>Customer Name</th>
                    <th>Phone Contact</th>
                    <th>Table Assignment</th>
                    <th>Scheduled Date &amp; Time</th>
                    <th>Party Size</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge rms-badge-primary">#RES-@item.ReservationId</span>
                            </td>
                            <td>
                                <strong class="text-dark">
                                    <i class="bi bi-person text-muted me-1"></i>
                                    @(item.Customer?.CustomerName ?? "Reserved Guest")
                                </strong>
                            </td>
                            <td>
                                <span class="text-muted">
                                    <i class="bi bi-telephone me-1"></i>
                                    @(item.Customer?.Phone ?? "Not specified")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">
                                    <i class="bi bi-table text-warning me-1"></i>
                                    @(item.DiningTable != null ? $"Table {item.DiningTable.TableNumber}" : "Unassigned")
                                </span>
                            </td>
                            <td>
                                <span class="text-dark font-monospace small">@item.ReservationDate.ToString("dd MMM yyyy")</span>
                                <br />
                                <small class="text-muted font-monospace">@item.ReservationDate.ToString("hh:mm tt")</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-people text-warning me-1"></i> @item.Guests Guests
                                </span>
                            </td>
                            <td>
                                @if (item.Status == "Confirmed")
                                {
                                    <span class="rms-badge rms-badge-success"><span class="rms-badge-dot"></span> Confirmed</span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="rms-badge rms-badge-warning"><span class="rms-badge-dot"></span> Pending</span>
                                }
                                else if (item.Status == "Completed")
                                {
                                    <span class="rms-badge rms-badge-primary"><span class="rms-badge-dot"></span> Completed</span>
                                }
                                else if (item.Status == "Cancelled")
                                {
                                    <span class="rms-badge rms-badge-danger"><span class="rms-badge-dot"></span> Cancelled</span>
                                }
                                else
                                {
                                    <span class="rms-badge rms-badge-secondary"><span class="rms-badge-dot"></span> @item.Status</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="rms-action-btn-group">
                                    <a asp-action="Details" asp-route-id="@item.ReservationId" class="rms-action-btn" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.ReservationId" class="rms-action-btn" title="Edit Booking">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ReservationId" class="rms-action-btn delete" title="Cancel Booking">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div class="rms-empty-state">
                                <div class="rms-empty-icon"><i class="bi bi-calendar-check"></i></div>
                                <h4 class="rms-empty-title">No Reservations Scheduled</h4>
                                <p class="rms-empty-desc">Create your first dining reservation to allocate tables and schedule guests.</p>
                                <a asp-action="Create" class="btn rms-btn-primary">
                                    <i class="bi bi-plus-lg"></i> Book New Table
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>