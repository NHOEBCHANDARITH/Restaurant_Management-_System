@model Restaurant_Management__System.Models.Reservation
@{
    ViewData["Title"] = "Cancel Reservation #" + Model.ReservationId;
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="rms-card">
            <div class="rms-card-body p-4 text-center">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" 
                     style="width: 72px; height: 72px; background: rgba(239, 68, 68, 0.12); color: #ef4444; font-size: 32px;">
                    <i class="bi bi-calendar-x"></i>
                </div>

                <h4 class="fw-bold text-dark mb-1">Cancel Reservation?</h4>
                <p class="text-muted small mb-4">
                    Are you sure you want to cancel the table reservation for <strong class="text-dark">@(Model.Customer?.CustomerName ?? "Guest")</strong>?
                </p>

                <div class="border rounded-3 p-3 bg-light text-start mb-4 small">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Booking Reference</span>
                        <strong class="text-dark font-monospace">#RES-@Model.ReservationId</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Date &amp; Time</span>
                        <strong class="text-dark">@Model.ReservationDate.ToString("dd/MM/yyyy hh:mm tt")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Table</span>
                        <strong class="text-dark">@(Model.DiningTable != null ? $"Table {Model.DiningTable.TableNumber}" : "Unassigned")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Guests</span>
                        <strong class="text-dark">@Model.Guests Persons</strong>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReservationId" />
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Index" class="btn rms-btn-secondary">Keep Booking</a>
                        <button type="submit" class="btn rms-btn-danger">
                            <i class="bi bi-trash"></i> Cancel Reservation
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>