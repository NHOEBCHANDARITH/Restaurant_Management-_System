@model Restaurant_Management__System.Models.Reservation
@{
    ViewData["Title"] = "Edit Reservation #" + Model.ReservationId;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="rms-form-card">
            <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                <div class="rms-brand-logo-icon" style="width: 44px; height: 44px; font-size: 20px;">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-dark mb-0">Modify Reservation #@Model.ReservationId</h4>
                    <small class="text-muted">Reschedule time, adjust guest party size, or change status</small>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReservationId" />
                <div asp-validation-summary="ModelOnly" class="rms-alert rms-alert-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="rms-form-label">
                            Guest / Customer <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-person rms-input-icon"></i>
                            <select asp-for="CustomerId" class="form-select rms-form-control" asp-items="ViewBag.CustomerId" required></select>
                        </div>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TableId" class="rms-form-label">
                            Dining Table <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-table rms-input-icon"></i>
                            <select asp-for="TableId" class="form-select rms-form-control" asp-items="ViewBag.TableId" required></select>
                        </div>
                        <span asp-validation-for="TableId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ReservationDate" class="rms-form-label">
                            Reservation Date &amp; Time <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-calendar-event rms-input-icon"></i>
                            <input asp-for="ReservationDate" type="datetime-local" class="rms-form-control" 
                                   value="@Model.ReservationDate.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                        <span asp-validation-for="ReservationDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Guests" class="rms-form-label">
                            Party Size (Guests) <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-people rms-input-icon"></i>
                            <input asp-for="Guests" type="number" min="1" max="100" class="rms-form-control" required />
                        </div>
                        <span asp-validation-for="Guests" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Status" class="rms-form-label">Booking Status</label>
                        <div class="rms-input-group">
                            <i class="bi bi-flag rms-input-icon"></i>
                            <select asp-for="Status" class="form-select rms-form-control">
                                <option value="Confirmed">Confirmed (Booking Locked)</option>
                                <option value="Pending">Pending (Awaiting Staff Confirmation)</option>
                                <option value="Completed">Completed (Dined)</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn rms-btn-primary">
                        <i class="bi bi-check-lg"></i> Update Booking
                    </button>
                    <a asp-action="Index" class="btn rms-btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}