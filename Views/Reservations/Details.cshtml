@model Restaurant_Management__System.Models.Reservation
@{
    ViewData["Title"] = "Reservation Details #" + Model.ReservationId;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="rms-card">
            <div class="rms-card-header bg-light">
                <h5 class="rms-card-title">
                    <i class="bi bi-calendar2-check text-warning"></i>
                    Reservation Schedule
                </h5>
                <span class="badge bg-secondary font-monospace">#RES-@Model.ReservationId</span>
            </div>
            <div class="rms-card-body p-4 text-center">
                <div class="rms-brand-logo-icon mx-auto my-3" style="width: 72px; height: 72px; font-size: 32px;">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">@(Model.Customer?.CustomerName ?? "Reserved Guest")</h3>
                <p class="text-muted mb-4">Confirmed Seating Booking</p>

                <div class="border rounded-3 p-3 bg-light text-start mb-4 small">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-calendar-event me-2"></i> Date &amp; Time</span>
                        <strong class="text-dark">@Model.ReservationDate.ToString("dd MMMM yyyy, hh:mm tt")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-people me-2"></i> Party Size</span>
                        <strong class="text-dark">@Model.Guests Guests</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-table me-2"></i> Assigned Table</span>
                        <strong class="text-dark">@(Model.DiningTable != null ? $"Table {Model.DiningTable.TableNumber} ({Model.DiningTable.Capacity} seats)" : "Unassigned")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-telephone me-2"></i> Contact Phone</span>
                        <strong class="text-dark">@(Model.Customer?.Phone ?? "No phone recorded")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted"><i class="bi bi-flag me-2"></i> Status</span>
                        <span>
                            @if (Model.Status == "Confirmed")
                            {
                                <span class="rms-badge rms-badge-success"><span class="rms-badge-dot"></span> Confirmed</span>
                            }
                            else if (Model.Status == "Pending")
                            {
                                <span class="rms-badge rms-badge-warning"><span class="rms-badge-dot"></span> Pending</span>
                            }
                            else
                            {
                                <span class="rms-badge rms-badge-info"><span class="rms-badge-dot"></span> @Model.Status</span>
                            }
                        </span>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.ReservationId" class="btn rms-btn-primary">
                        <i class="bi bi-pencil"></i> Edit Booking
                    </a>
                    <a asp-controller="Orders" asp-action="Create" class="btn rms-btn-outline">
                        <i class="bi bi-receipt"></i> Start Order
                    </a>
                    <a asp-action="Index" class="btn rms-btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>