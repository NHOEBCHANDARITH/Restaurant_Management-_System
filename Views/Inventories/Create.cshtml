@{
}
@model Restaurant_Management__System.Models.Inventory

@{
    ViewData["Title"] = "Create Inventory";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card">

            <div class="card-body p-4">

                <h3 class="fw-bold mb-4">
                    <i class="bi bi-plus-circle text-primary"></i>
                    Create Inventory
                </h3>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <!-- Ingredient -->
                    <div class="mb-3">

                        <label asp-for="IngredientId"
                               class="form-label fw-semibold">
                            Ingredient
                        </label>

                        <select asp-for="IngredientId"
                                class="form-select"
                                asp-items="ViewBag.IngredientId">

                            <option value="">
                                -- Select Ingredient --
                            </option>

                        </select>

                        <span asp-validation-for="IngredientId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Quantity -->
                    <div class="mb-3">

                        <label asp-for="Quantity"
                               class="form-label fw-semibold">
                            Quantity
                        </label>

                        <input asp-for="Quantity"
                               type="number"
                               min="0"
                               class="form-control"
                               placeholder="Enter quantity" />

                        <span asp-validation-for="Quantity"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Last Updated -->
                    <div class="mb-4">

                        <label asp-for="LastUpdated"
                               class="form-label fw-semibold">
                            Last Updated
                        </label>

                        <input asp-for="LastUpdated"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="LastUpdated"
                              class="text-danger">
                        </span>

                    </div>

                    <hr />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-save"></i>
                            Save

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            <i class="bi bi-arrow-left"></i>
                            Back

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}