@{
}
@model Restaurant_Management__System.Models.Inventory

@{
    ViewData["Title"] = "Delete Inventory";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card">

            <div class="card-body p-4">

                <div class="text-center mb-4">

                    <i class="bi bi-exclamation-triangle text-danger"
                       style="font-size:65px;">
                    </i>

                    <h3 class="fw-bold mt-3">
                        Delete Inventory?
                    </h3>

                    <p class="text-muted">
                        Are you sure you want to delete this inventory record?
                    </p>

                </div>

                <div class="alert alert-danger">

                    <div class="row mb-2">

                        <div class="col-5 fw-bold">
                            Inventory ID:
                        </div>

                        <div class="col-7">
                            @Model.InventoryId
                        </div>

                    </div>

                    <div class="row mb-2">

                        <div class="col-5 fw-bold">
                            Ingredient:
                        </div>

                        <div class="col-7">

                            @if (Model.Ingredient != null)
                            {
                                @Model.Ingredient.IngredientName
                            }
                            else
                            {
                                <span>
                                    No Ingredient
                                </span>
                            }

                        </div>

                    </div>

                    <div class="row mb-2">

                        <div class="col-5 fw-bold">
                            Quantity:
                        </div>

                        <div class="col-7">
                            @Model.Quantity
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-5 fw-bold">
                            Last Updated:
                        </div>

                        <div class="col-7">
                            @Model.LastUpdated.ToString("dd MMM yyyy HH:mm")
                        </div>

                    </div>

                </div>

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="InventoryId" />

                    <div class="d-flex justify-content-center gap-2">

                        <button type="submit"
                                class="btn btn-danger">

                            <i class="bi bi-trash"></i>
                            Yes, Delete

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            <i class="bi bi-x-circle"></i>
                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>