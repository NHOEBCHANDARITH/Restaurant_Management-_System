@model Restaurant_Management__System.Models.Inventory
@{
    ViewData["Title"] = "Stock Audit #" + Model.InventoryId;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="rms-card">
            <div class="rms-card-header bg-light">
                <h5 class="rms-card-title">
                    <i class="bi bi-boxes text-warning"></i>
                    Inventory Stock Audit Details
                </h5>
                <span class="badge bg-secondary font-monospace">#INV-@Model.InventoryId</span>
            </div>
            <div class="rms-card-body p-4 text-center">
                <div class="rms-brand-logo-icon mx-auto my-3" style="width: 72px; height: 72px; font-size: 32px;">
                    <i class="bi bi-box-seam"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">@(Model.Ingredient?.IngredientName ?? $"Ingredient #{Model.IngredientId}")</h3>
                <p class="text-muted mb-4">Stock Audit Record</p>

                <div class="border rounded-3 p-3 bg-light text-start mb-4 small">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-stack me-2"></i> Quantity in Hand</span>
                        <strong class="text-dark font-monospace fs-6">@Model.Quantity @(Model.Ingredient?.Unit ?? "units")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-calendar-check me-2"></i> Last Audit Timestamp</span>
                        <strong class="text-dark">@Model.LastUpdated.ToString("dd MMM yyyy, hh:mm tt")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted"><i class="bi bi-shield-check me-2"></i> Health Status</span>
                        <span>
                            @if (Model.Quantity <= 0)
                            {
                                <span class="rms-badge rms-badge-danger"><span class="rms-badge-dot"></span> Out of Stock</span>
                            }
                            else if (Model.Quantity < 10)
                            {
                                <span class="rms-badge rms-badge-warning"><span class="rms-badge-dot"></span> Low Stock Warning</span>
                            }
                            else
                            {
                                <span class="rms-badge rms-badge-success"><span class="rms-badge-dot"></span> Healthy Level</span>
                            }
                        </span>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.InventoryId" class="btn rms-btn-primary">
                        <i class="bi bi-pencil"></i> Adjust Stock
                    </a>
                    <a asp-controller="Suppliers" asp-action="Index" class="btn rms-btn-outline">
                        <i class="bi bi-truck"></i> Suppliers
                    </a>
                    <a asp-action="Index" class="btn rms-btn-secondary">Back to Stock List</a>
                </div>
            </div>
        </div>
    </div>
</div>