@{
}
@model Restaurant_Management__System.Models.Inventory

@{
    ViewData["Title"] = "Inventory Details";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>
                        <h3 class="fw-bold mb-1">
                            Inventory Details
                        </h3>

                        <p class="text-muted mb-0">
                            View inventory information
                        </p>
                    </div>

                    <i class="bi bi-clipboard-data text-primary"
                       style="font-size:45px;">
                    </i>

                </div>

                <table class="table table-bordered">

                    <tr>
                        <th style="width:35%;">
                            Inventory ID
                        </th>

                        <td>
                            @Model.InventoryId
                        </td>
                    </tr>

                    <tr>
                        <th>
                            Ingredient
                        </th>

                        <td>
                            @if (Model.Ingredient != null)
                            {
                                <strong>
                                    @Model.Ingredient.IngredientName
                                </strong>
                            }
                            else
                            {
                                <span class="text-muted">
                                    No Ingredient
                                </span>
                            }
                        </td>
                    </tr>

                    <tr>
                        <th>
                            Quantity
                        </th>

                        <td>
                            @if (Model.Quantity <= 0)
                            {
                                <span class="badge bg-danger">
                                    Out of Stock
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    @Model.Quantity
                                </span>
                            }
                        </td>
                    </tr>

                    <tr>
                        <th>
                            Last Updated
                        </th>

                        <td>
                            @Model.LastUpdated.ToString("dd MMM yyyy HH:mm")
                        </td>
                    </tr>

                </table>

                <hr />

                <div class="d-flex gap-2">

                    <a asp-action="Edit"
                       asp-route-id="@Model.InventoryId"
                       class="btn btn-warning">

                        <i class="bi bi-pencil"></i>
                        Edit

                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.InventoryId"
                       class="btn btn-danger">

                        <i class="bi bi-trash"></i>
                        Delete

                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Back

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>