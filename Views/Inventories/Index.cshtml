@{
}
@model IEnumerable<Restaurant_Management__System.Models.Inventory>

@{
    ViewData["Title"] = "Inventories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold">Inventories</h2>
        <p class="text-muted mb-0">
            Manage restaurant inventory
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>
        Add Inventory
    </a>
</div>

<div class="card">
    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Ingredient</th>
                        <th>Quantity</th>
                        <th>Last Updated</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.InventoryId
                                </td>

                                <td>
                                    @if (item.Ingredient != null)
                                    {
                                        <strong>
                                            @item.Ingredient.IngredientName
                                        </strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No Ingredient
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Quantity <= 0)
                                    {
                                        <span class="badge bg-danger">
                                            Out of Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            @item.Quantity
                                        </span>
                                    }
                                </td>

                                <td>
                                    @item.LastUpdated.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@item.InventoryId"
                                       class="btn btn-sm btn-info text-white"
                                       title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.InventoryId"
                                       class="btn btn-sm btn-warning"
                                       title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.InventoryId"
                                       class="btn btn-sm btn-danger"
                                       title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center text-muted py-5">

                                <i class="bi bi-clipboard-data fs-1"></i>

                                <p class="mt-2 mb-0">
                                    No inventory records found.
                                </p>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>