@{
}
@model Restaurant_Management__System.Models.MenuItem

@{
    ViewData["Title"] = "Delete Menu Item";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card">

            <div class="card-body p-4">

                <div class="text-center mb-4">

                    <i class="bi bi-exclamation-triangle text-danger"
                       style="font-size:65px;">
                    </i>

                    <h3 class="fw-bold mt-3">
                        Delete Menu Item?
                    </h3>

                    <p class="text-muted">
                        Are you sure you want to delete this menu item?
                    </p>

                </div>

                <div class="alert alert-danger">

                    <div class="row mb-2">

                        <div class="col-5 fw-bold">
                            Item ID:
                        </div>

                        <div class="col-7">
                            @Model.ItemId
                        </div>

                    </div>

                    <div class="row mb-2">

                        <div class="col-5 fw-bold">
                            Item Name:
                        </div>

                        <div class="col-7">
                            @Model.ItemName
                        </div>

                    </div>

                    <div class="row mb-2">

                        <div class="col-5 fw-bold">
                            Category:
                        </div>

                        <div class="col-7">

                            @if (Model.Category != null)
                            {
                                @Model.Category.CategoryName
                            }
                            else
                            {
                                <span>
                                    No Category
                                </span>
                            }

                        </div>

                    </div>

                    <div class="row mb-2">

                        <div class="col-5 fw-bold">
                            Price:
                        </div>

                        <div class="col-7">
                            $@Model.Price.ToString("N2")
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-5 fw-bold">
                            Status:
                        </div>

                        <div class="col-7">

                            @if (Model.Status == "Available")
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else if (Model.Status == "Unavailable")
                            {
                                <span class="badge bg-danger">
                                    Unavailable
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @Model.Status
                                </span>
                            }

                        </div>

                    </div>

                </div>

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="ItemId" />

                    <div class="d-flex justify-content-center gap-2">

                        <button type="submit"
                                class="btn btn-danger">

                            <i class="bi bi-trash"></i>
                            Yes, Delete

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            <i class="bi bi-x-circle"></i>
                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>