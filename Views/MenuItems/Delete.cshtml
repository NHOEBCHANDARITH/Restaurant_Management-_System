@model Restaurant_Management__System.Models.MenuItem
@{
    ViewData["Title"] = "Delete " + Model.ItemName;
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="rms-card">
            <div class="rms-card-body p-4 text-center">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" 
                     style="width: 72px; height: 72px; background: rgba(239, 68, 68, 0.12); color: #ef4444; font-size: 32px;">
                    <i class="bi bi-trash3-fill"></i>
                </div>

                <h4 class="fw-bold text-dark mb-1">Remove Menu Item?</h4>
                <p class="text-muted small mb-4">
                    Are you sure you want to permanently delete <strong class="text-dark">@Model.ItemName</strong> from the culinary menu?
                </p>

                <div class="border rounded-3 p-3 bg-light text-start mb-4 small">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Item Name</span>
                        <strong class="text-dark">@Model.ItemName</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Category</span>
                        <strong class="text-dark">@(Model.Category?.CategoryName ?? "General")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Price</span>
                        <strong class="text-danger font-monospace">$@Model.Price.ToString("F2")</strong>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ItemId" />
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Index" class="btn rms-btn-secondary">Cancel</a>
                        <button type="submit" class="btn rms-btn-danger">
                            <i class="bi bi-trash"></i> Yes, Delete Dish
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>