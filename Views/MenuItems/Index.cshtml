@model IEnumerable<Restaurant_Management__System.Models.MenuItem>

@{
    ViewData["Title"] = "Menu Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold text-dark mb-1">Menu Dishes <span class="badge bg-primary bg-opacity-10 text-primary ms-2 fs-6 align-middle">@Model.Count() Items</span></h3>
        <p class="text-muted mb-0">Manage your restaurant's food and beverage offerings.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-3 px-4 shadow-sm fw-semibold" style="background: linear-gradient(135deg, #48beda 0%, #2099b5 100%); border: none;">
        <i class="bi bi-plus-lg me-1"></i> Add New Dish
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <!-- Optional Filter Bar placeholder -->
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control bg-light border-start-0 ps-0" placeholder="Search menu...">
        </div>
        <div>
            <!-- Category Filter placeholder -->
            <select class="form-select bg-light border-0 text-muted fw-medium">
                <option value="">All Categories</option>
                <!-- Can be populated via ViewBag if needed later -->
            </select>
        </div>
    </div>
    
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted">
                    <tr>
                        <th class="ps-4 border-0">Dish</th>
                        <th class="border-0">Price</th>
                        <th class="border-0">Status</th>
                        <th class="text-end pe-4 border-0">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.ItemName" class="rounded-3 object-fit-cover shadow-sm" style="width: 56px; height: 56px;" onerror="this.src='https://placehold.co/100x100?text=No+Img'" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded-3 d-flex align-items-center justify-content-center text-muted shadow-sm border" style="width: 56px; height: 56px;">
                                                    <i class="bi bi-image fs-4 opacity-50"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="ms-3">
                                            <h6 class="mb-1 fw-bold text-dark">@item.ItemName</h6>
                                            <span class="text-muted small fw-medium">
                                                <i class="bi bi-tag-fill me-1 opacity-50"></i> @(item.Category?.CategoryName ?? "No Category")
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@item.Price.ToString("C")</span>
                                </td>
                                <td>
                                    @if (item.Status == "Available")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 border border-success border-opacity-25">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 border border-secondary border-opacity-25">@item.Status</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.ItemId" class="btn btn-sm btn-light text-primary rounded-circle shadow-sm me-1" style="width: 36px; height: 36px; line-height: 24px;" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ItemId" class="btn btn-sm btn-light text-danger rounded-circle shadow-sm" style="width: 36px; height: 36px; line-height: 24px;" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                <i class="bi bi-egg-fried fs-1 text-black-50 mb-3 d-block"></i>
                                No menu items found. Click "Add New Dish" to get started.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>