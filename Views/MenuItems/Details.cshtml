@model Restaurant_Management__System.Models.MenuItem
@{
    ViewData["Title"] = "Menu Item - " + Model.ItemName;
    string fallbackImg = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c";
    string imgUrl = string.IsNullOrWhiteSpace(Model.ImageUrl) ? fallbackImg : Model.ImageUrl;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="rms-card overflow-hidden">
            <div style="height: 280px; position: relative; overflow: hidden; background: #0f172a;">
                <img src="@imgUrl" alt="@Model.ItemName" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='@fallbackImg';" />
                <span class="badge position-absolute top-0 start-0 m-3 bg-dark bg-opacity-75 rounded-pill px-3 py-1">
                    @(Model.Category?.CategoryName ?? "Specialty")
                </span>
                <span class="rms-food-price-badge">
                    $@Model.Price.ToString("F2")
                    <small>@((Model.Price * 4100).ToString("N0")) ៛</small>
                </span>
            </div>

            <div class="rms-card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold text-dark mb-0">@Model.ItemName</h3>
                    @if (string.IsNullOrEmpty(Model.Status) || Model.Status.Equals("Available", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="rms-badge rms-badge-success py-1 px-3 fs-6"><span class="rms-badge-dot"></span> Available</span>
                    }
                    else
                    {
                        <span class="rms-badge rms-badge-danger py-1 px-3 fs-6"><span class="rms-badge-dot"></span> Sold Out</span>
                    }
                </div>

                <p class="text-muted fs-6 mb-4">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Freshly cooked specialty prepared according to authentic culinary recipes." : Model.Description)
                </p>

                <div class="border rounded-3 p-3 bg-light mb-4 small">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Item Catalog ID</span>
                        <strong class="text-dark font-monospace">#ITEM-@Model.ItemId</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Menu Category</span>
                        <strong class="text-dark">@(Model.Category?.CategoryName ?? "General")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Serving Price in Riel</span>
                        <strong class="text-warning font-monospace">@((Model.Price * 4100).ToString("N0")) ៛ (KHR)</strong>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.ItemId" class="btn rms-btn-primary">
                        <i class="bi bi-pencil"></i> Edit Item
                    </a>
                    <a asp-controller="Orders" asp-action="Create" class="btn rms-btn-outline">
                        <i class="bi bi-cart-plus"></i> Add to Order
                    </a>
                    <a asp-action="Index" class="btn rms-btn-secondary ms-auto">Back to Menu</a>
                </div>
            </div>
        </div>
    </div>
</div>