@{
}
@model Restaurant_Management__System.Models.MenuItem

@{
    ViewData["Title"] = "Menu Item Details";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>

                        <h3 class="fw-bold mb-1">
                            Menu Item Details
                        </h3>

                        <p class="text-muted mb-0">
                            View menu item information
                        </p>

                    </div>

                    <i class="bi bi-menu-button-wide text-primary"
                       style="font-size:45px;">
                    </i>

                </div>

                <table class="table table-bordered">

                    <tr>

                        <th style="width:35%;">
                            Item ID
                        </th>

                        <td>
                            @Model.ItemId
                        </td>

                    </tr>

                    <tr>

                        <th>
                            Item Name
                        </th>

                        <td>
                            <strong>
                                @Model.ItemName
                            </strong>
                        </td>

                    </tr>

                    <tr>

                        <th>
                            Category
                        </th>

                        <td>

                            @if (Model.Category != null)
                            {
                                @Model.Category.CategoryName
                            }
                            else
                            {
                                <span class="text-muted">
                                    No Category
                                </span>
                            }

                        </td>

                    </tr>

                    <tr>

                        <th>
                            Price
                        </th>

                        <td>

                            <strong>
                                $@Model.Price.ToString("N2")
                            </strong>

                        </td>

                    </tr>

                    <tr>

                        <th>
                            Description
                        </th>

                        <td>

                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                @Model.Description
                            }
                            else
                            {
                                <span class="text-muted">
                                    No description
                                </span>
                            }

                        </td>

                    </tr>

                    <tr>

                        <th>
                            Status
                        </th>

                        <td>

                            @if (Model.Status == "Available")
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else if (Model.Status == "Unavailable")
                            {
                                <span class="badge bg-danger">
                                    Unavailable
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @Model.Status
                                </span>
                            }

                        </td>

                    </tr>

                </table>

                <hr />

                <div class="d-flex gap-2">

                    <a asp-action="Edit"
                       asp-route-id="@Model.ItemId"
                       class="btn btn-warning">

                        <i class="bi bi-pencil"></i>
                        Edit

                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.ItemId"
                       class="btn btn-danger">

                        <i class="bi bi-trash"></i>
                        Delete

                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Back

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>