@model Restaurant_Management__System.Models.MenuItem

@{
    ViewData["Title"] = "Add New Dish";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold text-dark mb-1">Add New Dish</h3>
        <p class="text-muted mb-0">Create a new item for your restaurant menu.</p>
    </div>
    <a asp-action="Index" class="btn btn-light text-dark fw-semibold rounded-3 shadow-sm px-4 border">
        <i class="bi bi-arrow-left me-1"></i> Back to Menu
    </a>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

    <div class="row g-4">
        <!-- Left Column: Core Details -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                    <h5 class="fw-bold mb-0"><i class="bi bi-info-circle text-primary me-2"></i> Core Details</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <label asp-for="ItemName" class="form-label fw-semibold text-dark">Dish Name <span class="text-danger">*</span></label>
                            <input asp-for="ItemName" class="form-control form-control-lg rounded-3 bg-light border-0 fs-6" placeholder="e.g. Classic Cheeseburger" required />
                            <span asp-validation-for="ItemName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold text-dark">Category <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" class="form-select form-select-lg rounded-3 bg-light border-0 fs-6" asp-items="ViewBag.Categories" required>
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold text-dark">Price <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-currency-dollar"></i></span>
                                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control rounded-end-3 bg-light border-0 fs-6" placeholder="0.00" required />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label fw-semibold text-dark">Description</label>
                            <textarea asp-for="Description" class="form-control rounded-3 bg-light border-0" rows="5" placeholder="Describe the dish ingredients and flavor..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Media & Status -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                    <h5 class="fw-bold mb-0"><i class="bi bi-image text-primary me-2"></i> Media & Status</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label asp-for="Status" class="form-label fw-semibold text-dark">Availability</label>
                        <select asp-for="Status" class="form-select form-select-lg rounded-3 bg-light border-0 fs-6">
                            <option value="Available">Available</option>
                            <option value="Out of Stock">Out of Stock</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label fw-semibold text-dark">Image URL</label>
                        <input asp-for="ImageUrl" id="imageUrlInput" class="form-control rounded-3 bg-light border-0" placeholder="https://example.com/image.jpg" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <!-- Live Image Preview -->
                    <div class="mt-4 text-center p-3 border rounded-3 bg-light" style="border-style: dashed !important;">
                        <p class="text-muted small mb-2 fw-semibold">Live Preview</p>
                        <img id="imagePreview" src="https://placehold.co/300x200?text=No+Image" alt="Preview" class="img-fluid rounded-3 shadow-sm object-fit-cover w-100" style="height: 180px; display: block;" onerror="this.src='https://placehold.co/300x200?text=Invalid+URL'" />
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary w-100 py-3 rounded-4 shadow-sm fw-bold fs-5" style="background: linear-gradient(135deg, #48beda 0%, #2099b5 100%); border: none;">
                <i class="bi bi-check-circle me-2"></i> Save Dish
            </button>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('imageUrlInput').addEventListener('input', function() {
            var url = this.value.trim();
            var preview = document.getElementById('imagePreview');
            if (url) {
                preview.src = url;
            } else {
                preview.src = 'https://placehold.co/300x200?text=No+Image';
            }
        });
    </script>
}