@model Restaurant_Management__System.Models.MenuItem
@{
    ViewData["Title"] = "Add Menu Item";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="rms-form-card">
            <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                <div class="rms-brand-logo-icon" style="width: 44px; height: 44px; font-size: 20px;">
                    <i class="bi bi-cup-hot"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-dark mb-0">Create Menu Dish</h4>
                    <small class="text-muted">Add a culinary recipe, pricing, and photo to the restaurant menu</small>
                </div>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="rms-alert rms-alert-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ItemName" class="rms-form-label">
                            Dish / Item Name <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-card-heading rms-input-icon"></i>
                            <input asp-for="ItemName" class="rms-form-control" placeholder="e.g. Fish Amok, Lok Lak Beef" required />
                        </div>
                        <span asp-validation-for="ItemName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="rms-form-label">
                            Food Category <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-tags rms-input-icon"></i>
                            <select asp-for="CategoryId" class="form-select rms-form-control" asp-items="ViewBag.CategoryId" required>
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="rms-form-label">
                            Price ($ USD) <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-currency-dollar rms-input-icon"></i>
                            <input asp-for="Price" type="number" step="0.01" min="0" class="rms-form-control" placeholder="e.g. 8.50" required />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="rms-form-label">Availability Status</label>
                        <div class="rms-input-group">
                            <i class="bi bi-check2-circle rms-input-icon"></i>
                            <select asp-for="Status" class="form-select rms-form-control">
                                <option value="Available" selected>Available (Ready to Serve)</option>
                                <option value="Unavailable">Unavailable / Sold Out</option>
                            </select>
                        </div>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="ImageUrl" class="rms-form-label">Image URL</label>
                        <div class="rms-input-group">
                            <i class="bi bi-image rms-input-icon"></i>
                            <input asp-for="ImageUrl" type="url" class="rms-form-control" placeholder="https://images.unsplash.com/..." />
                        </div>
                        <small class="text-muted">Enter a web URL to high-resolution culinary photography.</small>
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Description" class="rms-form-label">Dish Description &amp; Flavors</label>
                        <textarea asp-for="Description" rows="3" class="rms-form-control" 
                                  placeholder="Describe the taste profile, ingredients, and spices..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn rms-btn-primary">
                        <i class="bi bi-save"></i> Save Menu Dish
                    </button>
                    <a asp-action="Index" class="btn rms-btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}