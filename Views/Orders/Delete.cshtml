@model Restaurant_Management__System.Models.Order
@{
    ViewData["Title"] = "Cancel Order #" + Model.OrderId;
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="rms-card">
            <div class="rms-card-body p-4 text-center">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" 
                     style="width: 72px; height: 72px; background: rgba(239, 68, 68, 0.12); color: #ef4444; font-size: 32px;">
                    <i class="bi bi-receipt"></i>
                </div>

                <h4 class="fw-bold text-dark mb-1">Delete Order Ticket?</h4>
                <p class="text-muted small mb-4">
                    Are you sure you want to delete <strong class="text-dark">Order #@Model.OrderId</strong>? 
                    This will remove the ticket and its associated sales tracking data.
                </p>

                <div class="border rounded-3 p-3 bg-light text-start mb-4 small">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Customer</span>
                        <strong class="text-dark">@(Model.Customer?.CustomerName ?? "Walk-in Guest")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Table</span>
                        <strong class="text-dark">@(Model.DiningTable != null ? $"Table {Model.DiningTable.TableNumber}" : "Takeaway")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Order Date</span>
                        <strong class="text-dark">@Model.OrderDate.ToString("dd/MM/yyyy hh:mm tt")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Total Amount</span>
                        <strong class="text-danger font-monospace">$@Model.TotalAmount.ToString("N2")</strong>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OrderId" />
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Index" class="btn rms-btn-secondary">Cancel</a>
                        <button type="submit" class="btn rms-btn-danger">
                            <i class="bi bi-trash"></i> Yes, Delete Order
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>