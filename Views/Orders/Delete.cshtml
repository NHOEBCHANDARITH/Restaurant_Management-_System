@{
}
@model Restaurant_Management__System.Models.Order

@{
    ViewData["Title"] = "Delete Order";
}

<div class="row justify-content-center">

    <div class="col-md-8">

        <div class="card">

            <div class="card-body p-4 text-center">

                <i class="bi bi-exclamation-triangle-fill text-danger"
                   style="font-size: 70px;">
                </i>

                <h3 class="fw-bold mt-3">
                    Delete Order?
                </h3>

                <p class="text-muted">
                    Are you sure you want to delete this order?
                    This action cannot be undone.
                </p>

                <div class="alert alert-light text-start">

                    <div class="row mb-3">

                        <div class="col-5 fw-bold">
                            Order ID:
                        </div>

                        <div class="col-7">
                            #@Model.OrderId
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-5 fw-bold">
                            Customer:
                        </div>

                        <div class="col-7">
                            @Model.Customer?.CustomerName
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-5 fw-bold">
                            Table:
                        </div>

                        <div class="col-7">
                            Table @Model.DiningTable?.TableNumber
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-5 fw-bold">
                            Staff / User:
                        </div>

                        <div class="col-7">
                            @Model.User?.FullName
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-5 fw-bold">
                            Order Date:
                        </div>

                        <div class="col-7">
                            @Model.OrderDate.ToString("dd/MM/yyyy hh:mm tt")
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-5 fw-bold">
                            Total Amount:
                        </div>

                        <div class="col-7">
                            <strong>
                                $@Model.TotalAmount.ToString("N2")
                            </strong>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-5 fw-bold">
                            Status:
                        </div>

                        <div class="col-7">
                            @Model.Status
                        </div>

                    </div>

                </div>

                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="OrderId" />

                    <button type="submit"
                            class="btn btn-danger">
                        <i class="bi bi-trash"></i>
                        Yes, Delete
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i>
                        Cancel
                    </a>

                </form>

            </div>

        </div>

    </div>

</div>