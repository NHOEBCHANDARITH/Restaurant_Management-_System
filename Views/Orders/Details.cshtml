@{
}
@model Restaurant_Management__System.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="row justify-content-center">

    <div class="col-md-9">

        <div class="card">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h3 class="fw-bold mb-0">
                        <i class="bi bi-cart-check text-info"></i>
                        Order Details
                    </h3>

                    <span class="badge bg-primary fs-6">
                        Order #@Model.OrderId
                    </span>

                </div>

                <div class="row">

                    <!-- Customer -->
                    <div class="col-md-6 mb-4">

                        <small class="text-muted">
                            Customer
                        </small>

                        <h5>
                            <i class="bi bi-person text-primary"></i>
                            @Model.Customer?.CustomerName
                        </h5>

                    </div>

                    <!-- Table -->
                    <div class="col-md-6 mb-4">

                        <small class="text-muted">
                            Dining Table
                        </small>

                        <h5>
                            <i class="bi bi-table text-primary"></i>
                            Table @Model.DiningTable?.TableNumber
                        </h5>

                    </div>

                    <!-- User -->
                    <div class="col-md-6 mb-4">

                        <small class="text-muted">
                            Staff / User
                        </small>

                        <h5>
                            <i class="bi bi-person-badge text-primary"></i>
                            @Model.User?.FullName
                        </h5>

                    </div>

                    <!-- Date -->
                    <div class="col-md-6 mb-4">

                        <small class="text-muted">
                            Order Date
                        </small>

                        <h5>
                            <i class="bi bi-calendar-event text-primary"></i>
                            @Model.OrderDate.ToString("dd/MM/yyyy")
                            <br />
                            <small class="text-muted">
                                @Model.OrderDate.ToString("hh:mm tt")
                            </small>
                        </h5>

                    </div>

                    <!-- Total -->
                    <div class="col-md-6 mb-4">

                        <small class="text-muted">
                            Total Amount
                        </small>

                        <h4 class="fw-bold text-success">
                            $@Model.TotalAmount.ToString("N2")
                        </h4>

                    </div>

                    <!-- Status -->
                    <div class="col-md-6 mb-4">

                        <small class="text-muted">
                            Status
                        </small>

                        <div class="mt-2">

                            @if (Model.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark fs-6">
                                    Pending
                                </span>
                            }
                            else if (Model.Status == "Processing")
                            {
                                <span class="badge bg-primary fs-6">
                                    Processing
                                </span>
                            }
                            else if (Model.Status == "Completed")
                            {
                                <span class="badge bg-success fs-6">
                                    Completed
                                </span>
                            }
                            else if (Model.Status == "Cancelled")
                            {
                                <span class="badge bg-danger fs-6">
                                    Cancelled
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">
                                    @Model.Status
                                </span>
                            }

                        </div>

                    </div>

                </div>

                <hr />

                <div class="mt-3">

                    <a asp-action="Edit"
                       asp-route-id="@Model.OrderId"
                       class="btn btn-warning">
                        <i class="bi bi-pencil"></i>
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.OrderId"
                       class="btn btn-danger">
                        <i class="bi bi-trash"></i>
                        Delete
                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i>
                        Back
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>