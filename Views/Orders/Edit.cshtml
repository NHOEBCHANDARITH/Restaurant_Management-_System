@model Restaurant_Management__System.Models.Order
@{
    ViewData["Title"] = "Edit Order #" + Model.OrderId;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="rms-form-card">
            <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                <div class="rms-brand-logo-icon" style="width: 44px; height: 44px; font-size: 20px;">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-dark mb-0">Update Order Ticket #@Model.OrderId</h4>
                    <small class="text-muted">Modify order total, table re-assignment, or status progression</small>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="OrderId" />
                <div asp-validation-summary="ModelOnly" class="rms-alert rms-alert-danger mb-3"></div>

                <div class="row g-3">
                    <!-- Customer Selection -->
                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="rms-form-label">
                            Guest / Customer <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-person rms-input-icon"></i>
                            <select asp-for="CustomerId" class="form-select rms-form-control" asp-items="ViewBag.CustomerId" required></select>
                        </div>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <!-- Dining Table -->
                    <div class="col-md-6">
                        <label asp-for="TableId" class="rms-form-label">
                            Dining Table <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-table rms-input-icon"></i>
                            <select asp-for="TableId" class="form-select rms-form-control" asp-items="ViewBag.TableId" required></select>
                        </div>
                        <span asp-validation-for="TableId" class="text-danger small"></span>
                    </div>

                    <!-- Staff Server -->
                    <div class="col-md-6">
                        <label asp-for="UserId" class="rms-form-label">
                            Assigned Server / Staff <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-person-badge rms-input-icon"></i>
                            <select asp-for="UserId" class="form-select rms-form-control" asp-items="ViewBag.UserId" required></select>
                        </div>
                        <span asp-validation-for="UserId" class="text-danger small"></span>
                    </div>

                    <!-- Date & Time -->
                    <div class="col-md-6">
                        <label asp-for="OrderDate" class="rms-form-label">Order Timestamp</label>
                        <div class="rms-input-group">
                            <i class="bi bi-calendar-event rms-input-icon"></i>
                            <input asp-for="OrderDate" type="datetime-local" class="rms-form-control" 
                                   value="@Model.OrderDate.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                        <span asp-validation-for="OrderDate" class="text-danger small"></span>
                    </div>

                    <!-- Total Amount -->
                    <div class="col-md-6">
                        <label asp-for="TotalAmount" class="rms-form-label">
                            Order Total Amount ($ USD) <span class="required-dot">*</span>
                        </label>
                        <div class="rms-input-group">
                            <i class="bi bi-currency-dollar rms-input-icon"></i>
                            <input asp-for="TotalAmount" type="number" step="0.01" min="0" class="rms-form-control" required />
                        </div>
                        <span asp-validation-for="TotalAmount" class="text-danger small"></span>
                    </div>

                    <!-- Order Status -->
                    <div class="col-md-6">
                        <label asp-for="Status" class="rms-form-label">Ticket Status</label>
                        <div class="rms-input-group">
                            <i class="bi bi-flag rms-input-icon"></i>
                            <select asp-for="Status" class="form-select rms-form-control">
                                <option value="Pending">Pending (Order Received)</option>
                                <option value="Preparing">Preparing (Kitchen Fired)</option>
                                <option value="Ready">Ready (Ready for Service)</option>
                                <option value="Completed">Completed (Served &amp; Paid)</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn rms-btn-primary">
                        <i class="bi bi-check-lg"></i> Update Ticket
                    </button>
                    <a asp-action="Index" class="btn rms-btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}