    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model Restaurant_Management__System.Models.Order

@{
    ViewData["Title"] = "Edit Order";
}

<div class="row justify-content-center">

    <div class="col-md-8">

        <div class="card">

            <div class="card-body p-4">

                <h3 class="fw-bold mb-4">
                    <i class="bi bi-pencil-square text-warning"></i>
                    Edit Order
                </h3>

                <form asp-action="Edit" method="post">

                    <input type="hidden"
                           asp-for="OrderId" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <!-- Customer -->
                    <div class="mb-3">

                        <label asp-for="CustomerId"
                               class="form-label">
                            Customer
                        </label>

                        <select asp-for="CustomerId"
                                class="form-select"
                                asp-items="ViewBag.CustomerId">

                            <option value="">
                                -- Select Customer --
                            </option>

                        </select>

                        <span asp-validation-for="CustomerId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Dining Table -->
                    <div class="mb-3">

                        <label asp-for="TableId"
                               class="form-label">
                            Dining Table
                        </label>

                        <select asp-for="TableId"
                                class="form-select"
                                asp-items="ViewBag.TableId">

                            <option value="">
                                -- Select Table --
                            </option>

                        </select>

                        <span asp-validation-for="TableId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- User -->
                    <div class="mb-3">

                        <label asp-for="UserId"
                               class="form-label">
                            Staff / User
                        </label>

                        <select asp-for="UserId"
                                class="form-select"
                                asp-items="ViewBag.UserId">

                            <option value="">
                                -- Select User --
                            </option>

                        </select>

                        <span asp-validation-for="UserId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Order Date -->
                    <div class="mb-3">

                        <label asp-for="OrderDate"
                               class="form-label">
                            Order Date & Time
                        </label>

                        <input asp-for="OrderDate"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="OrderDate"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Total Amount -->
                    <div class="mb-3">

                        <label asp-for="TotalAmount"
                               class="form-label">
                            Total Amount
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                $
                            </span>

                            <input asp-for="TotalAmount"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" />

                        </div>

                        <span asp-validation-for="TotalAmount"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Status -->
                    <div class="mb-3">

                        <label asp-for="Status"
                               class="form-label">
                            Status
                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            <option value="Pending">
                                Pending
                            </option>

                            <option value="Processing">
                                Processing
                            </option>

                            <option value="Completed">
                                Completed
                            </option>

                            <option value="Cancelled">
                                Cancelled
                            </option>

                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mt-4">

                        <button type="submit"
                                class="btn btn-warning">
                            <i class="bi bi-check-circle"></i>
                            Update Order
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i>
                            Back
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}