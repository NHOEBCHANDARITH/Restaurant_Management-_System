@model IEnumerable<Restaurant_Management__System.Models.Reservation>

@{
    ViewData["Title"] = "Reservations";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-calendar2-check text-primary me-2"></i>Reservations
        </h2>
        <p class="text-muted mb-0">Manage table bookings and guest schedule</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>
        New Reservation
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Customer</th>
                        <th>Table</th>
                        <th>Date & Time</th>
                        <th>Guests</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-secondary">#@item.ReservationId</span>
                                </td>
                                <td>
                                    <strong class="text-dark">
                                        <i class="bi bi-person text-muted me-1"></i>
                                        @(item.Customer?.CustomerName ?? "Guest")
                                    </strong>
                                </td>
                                <td>
                                    <span class="text-muted">
                                        <i class="bi bi-table text-primary me-1"></i>
                                        @(item.DiningTable != null ? $"Table {item.DiningTable.TableNumber}" : "Unassigned")
                                    </span>
                                </td>
                                <td>
                                    <span class="text-dark font-monospace small">@item.ReservationDate.ToString("dd/MM/yyyy")</span>
                                    <br />
                                    <small class="text-muted font-monospace">@item.ReservationDate.ToString("hh:mm tt")</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-people text-primary me-1"></i> @item.Guests
                                    </span>
                                </td>
                                <td>
                                    @if (item.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i> Confirmed
                                        </span>
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-clock me-1"></i> Pending
                                        </span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i> Cancelled
                                        </span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-primary">
                                            <i class="bi bi-check-all me-1"></i> Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.ReservationId" class="btn btn-sm btn-outline-secondary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.ReservationId" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ReservationId" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x display-6 d-block mb-2 text-primary opacity-50"></i>
                                No reservations found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>