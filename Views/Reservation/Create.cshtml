@{
}
@model Restaurant_Management__System.Models.Reservation

@{
    ViewData["Title"] = "Create Reservation";
}

<div class="row justify-content-center">

    <div class="col-md-8">

        <div class="card">

            <div class="card-body p-4">

                <h3 class="fw-bold mb-4">
                    <i class="bi bi-calendar-plus text-primary"></i>
                    Create Reservation
                </h3>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <!-- Customer -->
                    <div class="mb-3">

                        <label asp-for="CustomerId"
                               class="form-label">
                            Customer
                        </label>

                        <select asp-for="CustomerId"
                                class="form-select"
                                asp-items="ViewBag.CustomerId">

                            <option value="">
                                -- Select Customer --
                            </option>

                        </select>

                        <span asp-validation-for="CustomerId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Dining Table -->
                    <div class="mb-3">

                        <label asp-for="TableId"
                               class="form-label">
                            Dining Table
                        </label>

                        <select asp-for="TableId"
                                class="form-select"
                                asp-items="ViewBag.TableId">

                            <option value="">
                                -- Select Table --
                            </option>

                        </select>

                        <span asp-validation-for="TableId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Reservation Date -->
                    <div class="mb-3">

                        <label asp-for="ReservationDate"
                               class="form-label">
                            Reservation Date & Time
                        </label>

                        <input asp-for="ReservationDate"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="ReservationDate"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Guests -->
                    <div class="mb-3">

                        <label asp-for="Guests"
                               class="form-label">
                            Number of Guests
                        </label>

                        <input asp-for="Guests"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="Enter number of guests" />

                        <span asp-validation-for="Guests"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Status -->
                    <div class="mb-3">

                        <label asp-for="Status"
                               class="form-label">
                            Status
                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            <option value="">
                                -- Select Status --
                            </option>

                            <option value="Pending">
                                Pending
                            </option>

                            <option value="Confirmed">
                                Confirmed
                            </option>

                            <option value="Completed">
                                Completed
                            </option>

                            <option value="Cancelled">
                                Cancelled
                            </option>

                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mt-4">

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="bi bi-save"></i>
                            Save Reservation
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i>
                            Back
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}