@{
}
@model Restaurant_Management__System.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<div class="container py-4">

    <div class="card shadow-sm border-0">

        <div class="card-header bg-info text-white">
            <h4 class="mb-0">
                <i class="bi bi-receipt me-2"></i>
                Payment Details
            </h4>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-4">
                    Payment ID
                </dt>
                <dd class="col-sm-8">
                    @Model.PaymentId
                </dd>

                <dt class="col-sm-4">
                    Order ID
                </dt>
                <dd class="col-sm-8">
                    @Model.OrderId
                </dd>

                <dt class="col-sm-4">
                    Payment Method
                </dt>
                <dd class="col-sm-8">
                    @Model.PaymentMethod
                </dd>

                <dt class="col-sm-4">
                    Payment Date
                </dt>
                <dd class="col-sm-8">
                    @Model.PaymentDate.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-4">
                    Amount
                </dt>
                <dd class="col-sm-8 fw-bold">
                    $@Model.Amount.ToString("N2")
                </dd>

                <dt class="col-sm-4">
                    Payment Status
                </dt>
                <dd class="col-sm-8">

                    @if (Model.PaymentStatus == "Paid")
                    {
                        <span class="badge bg-success">
                            Paid
                        </span>
                    }
                    else if (Model.PaymentStatus == "Pending")
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            @Model.PaymentStatus
                        </span>
                    }

                </dd>

            </dl>

            <hr />

            <div class="d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.PaymentId"
                   class="btn btn-warning">
                    <i class="bi bi-pencil me-1"></i>
                    Edit
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.PaymentId"
                   class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>
                    Delete
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back
                </a>

            </div>

        </div>
    </div>

</div>