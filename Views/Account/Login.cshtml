@{
    ViewData["Title"] = "Staff Login";
    ViewData["NoSidebar"] = true;
}

<div class="rms-auth-wrapper">
    <!-- LEFT SIDE: LUXURY KHMER HOSPITALITY BRANDING -->
    <div class="rms-auth-left">
        <div class="d-flex align-items-center gap-3">
            <div class="rms-brand-logo-icon" style="width: 50px; height: 50px; font-size: 26px;">
                <i class="bi bi-fire"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-0 text-white">Sovannaphum</h4>
                <small class="text-warning text-uppercase letter-spacing-2" style="font-size: 11px; font-weight: 700;">
                    <i class="bi bi-stars"></i> Khmer Culinary &amp; RMS
                </small>
            </div>
        </div>

        <div class="my-auto py-5">
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
                <i class="bi bi-shield-lock-fill me-1"></i> Staff &amp; Management Portal
            </span>
            <h1 class="display-5 fw-extrabold text-white mb-3" style="font-weight: 800; line-height: 1.15;">
                Exceptional Dining, <br />
                <span style="color: #fbbf24;">Masterfully Managed.</span>
            </h1>
            <p class="text-light opacity-75 fs-6 mb-4" style="max-width: 480px; line-height: 1.7;">
                Real-time POS ordering, dining table floor scheduling, kitchen ingredient inventory, and guest hospitality management tailored for Cambodia's premier culinary establishments.
            </p>

            <div class="d-flex gap-4 pt-2">
                <div>
                    <h3 class="fw-bold text-warning mb-0">100%</h3>
                    <small class="text-white-50">Live Cloud Sync</small>
                </div>
                <div class="border-start border-light border-opacity-25 ps-4">
                    <h3 class="fw-bold text-warning mb-0">KHQR</h3>
                    <small class="text-white-50">Bakong Ready</small>
                </div>
                <div class="border-start border-light border-opacity-25 ps-4">
                    <h3 class="fw-bold text-warning mb-0">24/7</h3>
                    <small class="text-white-50">Dining Reliability</small>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center text-white-50 small">
            <span>&copy; 2026 Sovannaphum RMS. All rights reserved.</span>
            <a asp-controller="Home" asp-action="Index" class="text-warning text-decoration-none fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Public Website
            </a>
        </div>
    </div>

    <!-- RIGHT SIDE: MODERN LOGIN FORM -->
    <div class="rms-auth-right">
        <div class="rms-auth-card">
            <div class="text-center text-md-start mb-4">
                <h3 class="fw-bold text-dark mb-1">Welcome Back</h3>
                <p class="text-muted small">Please enter your credentials to access the management portal.</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="rms-alert rms-alert-danger mb-3 py-2 px-3 small">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>@ViewBag.Error</div>
                </div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <!-- Email Input -->
                <div class="mb-3">
                    <label class="rms-form-label">
                        Email Address <span class="required-dot">*</span>
                    </label>
                    <div class="rms-input-group">
                        <i class="bi bi-envelope rms-input-icon"></i>
                        <input type="email" name="email" id="loginEmail" class="rms-form-control" 
                               placeholder="name@sovannaphum.com" value="admin@sovannaphum.com" required autofocus />
                    </div>
                </div>

                <!-- Password Input with Show/Hide -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="rms-form-label mb-0">
                            Password <span class="required-dot">*</span>
                        </label>
                        <a href="javascript:void(0)" onclick="alert('Please contact your System Administrator to reset credentials.')" 
                           class="small text-muted text-decoration-none">
                            Forgot password?
                        </a>
                    </div>
                    <div class="rms-input-group position-relative">
                        <i class="bi bi-lock rms-input-icon"></i>
                        <input type="password" name="password" id="loginPassword" class="rms-form-control" 
                               placeholder="••••••••" value="admin123" required />
                        <button type="button" class="btn position-absolute top-50 end-0 translate-middle-y me-2 border-0 text-muted" 
                                onclick="togglePasswordVisibility('loginPassword', 'eyeIcon')" style="z-index: 5;">
                            <i class="bi bi-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Remember Me -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="rememberMe" id="rememberMe" checked />
                        <label class="form-check-label small text-muted" for="rememberMe">
                            Remember my login for 30 days
                        </label>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn rms-btn-primary w-100 justify-content-center py-2 fs-6 mb-3">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In to RMS
                </button>

                <!-- Demo quick access notice -->
                <div class="p-3 bg-light rounded-3 border text-center small text-muted mb-3">
                    <i class="bi bi-info-circle text-primary me-1"></i>
                    <strong>Demo Quick Access:</strong> Defaults prefilled. Click <em>Sign In</em> to enter.
                </div>

                <div class="text-center small text-muted">
                    New staff member? 
                    <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Register Account</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        }
    }
</script>
